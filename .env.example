# По умолчанию индексация запрещена (pages.dev, preview, локальная разработка).
# После подключения основного домена erazahan.info поставьте в Cloudflare Pages
# (Settings -> Environment variables, для окружения Production) переменную:
#   PUBLIC_ALLOW_INDEXING=true
# и пересоберите/передеплойте сайт — тогда robots.txt разрешит индексацию,
# а <meta name="robots" content="noindex, nofollow"> перестанет добавляться.
PUBLIC_ALLOW_INDEXING=false
