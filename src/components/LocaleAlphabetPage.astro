---
import { localeAlphabet, localeHome, localeUiCopy } from '../lib/public-locale.mjs';

interface Props {
  locale: 'ru' | 'en';
  groups: { alphabet_key: string; route_key: string; entries: unknown[] }[];
}

const { locale, groups } = Astro.props;
const copy = localeUiCopy(locale);
const homeHref = localeHome(locale);
const alphabetHref = localeAlphabet(locale);
---

<article class="post-article reveal mx-auto max-w-3xl px-4 py-12 sm:px-6" data-locale-alphabet={locale}>
  <nav aria-label="Breadcrumb" class="text-sm text-slate-400">
    <a href={homeHref} class="transition hover:text-white">{copy.navigation.home}</a>
    <span aria-hidden="true"> / </span>
    <span>{copy.alphabet.heading}</span>
  </nav>
  <h1 class="mt-5 font-display text-3xl font-bold leading-tight text-white sm:text-4xl">{copy.alphabet.heading}</h1>
  {groups.length ? (
    <div class="mt-10 flex flex-wrap gap-3">
      {groups.map((group) => (
        <a href={`${alphabetHref}${group.route_key}/`} class="grid size-12 place-items-center rounded-xl border border-white/10 bg-white/5 font-display text-lg font-bold text-white transition hover:border-violet-400/60 hover:bg-violet-500/20">
          {group.alphabet_key}
        </a>
      ))}
    </div>
  ) : <p class="mt-8 text-slate-400">{copy.alphabet.empty}</p>}
</article>
