---
import { publicPathFor } from '../lib/content-schema/multilingual-contract.mjs';
import { localeAlphabet, localeHome, localeUiCopy } from '../lib/public-locale.mjs';

interface Props {
  locale: 'ru' | 'en';
  alphabetKey: string;
  entries: { content_id: string; slug: string; title: string; alphabet_key: string }[];
  title: string;
}

const { locale, alphabetKey, entries, title } = Astro.props;
const copy = localeUiCopy(locale);
const homeHref = localeHome(locale);
const alphabetHref = localeAlphabet(locale);
---

<article class="post-article reveal mx-auto max-w-3xl px-4 py-12 sm:px-6">
  <nav aria-label="Breadcrumb" class="text-sm text-slate-400">
    <a href={homeHref} class="transition hover:text-white">{copy.navigation.home}</a>
    <span aria-hidden="true"> / </span>
    <a href={alphabetHref} class="transition hover:text-white">{copy.alphabet.heading}</a>
    <span aria-hidden="true"> / </span>
    <span>{alphabetKey}</span>
  </nav>
  <h1 class="font-display text-3xl font-bold leading-tight text-white sm:text-4xl">{title}</h1>
  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {entries.map((entry) => (
      <a href={publicPathFor(locale, entry.slug)} class="rounded-2xl border border-white/10 bg-white/5 p-5 transition hover:border-violet-400/60 hover:bg-violet-500/20">
        <span class="font-display text-lg font-bold text-white">{entry.title}</span>
      </a>
    ))}
  </div>
</article>
