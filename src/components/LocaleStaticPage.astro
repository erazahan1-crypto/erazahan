---
import Layout from '../layouts/Layout.astro';
import { getLocalizedStaticPage } from '../lib/content-source/localized-static-pages.mjs';
import { renderPostContent } from '../lib/render-post-content';
import { localeHome } from '../lib/public-locale.mjs';

interface Props {
  locale: 'ru' | 'en';
  pageId: 'about';
}

const { locale, pageId } = Astro.props;
const page = getLocalizedStaticPage(pageId, locale);
if (!page) throw new Error(`Localized static page is unavailable: ${pageId}/${locale}`);
const homeLabel = locale === 'ru' ? 'Главная' : 'Home';
const breadcrumbLabel = locale === 'ru' ? 'Навигационная цепочка' : 'Breadcrumb';
const renderedBody = renderPostContent(page.body_markdown);
---

<Layout title={page.title} description={page.description} type="website" locale={locale}>
  <article class="reveal mx-auto max-w-3xl px-4 py-12 sm:px-6" data-locale-static-page={page.page_id} data-locale={locale}>
    <nav class="text-sm text-slate-400" aria-label={breadcrumbLabel}>
      <a href={localeHome(locale)} class="transition hover:text-white">{homeLabel}</a>
      <span class="mx-1.5" aria-hidden="true">›</span>
      <span aria-current="page">{page.navigation_label}</span>
    </nav>
    <h1 class="mt-4 font-display text-3xl font-bold leading-tight text-white sm:text-4xl">{page.title}</h1>
    <div class="dream-content mt-6" set:html={renderedBody} />
  </article>
</Layout>
