---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import QuickTools from "../components/QuickTools.astro";
import { SITE } from "../lib/config";
import { websiteSchema } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  type?: string;
  image?: string;
}

const {
  title = "Երազահան — երազների մեկնաբանություն",
  description =
    "Անվճար օնլայն երազահան. երազների ճշգրիտ ու մանրամասն մեկնաբանություններ այբբենական կարգով:",
  type = "website",
  image,
} = Astro.props;

const ogImage = image ? (image.startsWith("http") ? image : `${SITE}${image}`) : undefined;
---

<!doctype html>
<html lang="hy">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>document.documentElement.classList.add('js-reveal');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={Astro.url} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Երազահան" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:locale" content="hy_AM" />
    {ogImage ? <meta property="og:image" content={ogImage} /> : null}

    <!-- Twitter -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage ? <meta name="twitter:image" content={ogImage} /> : null}

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema())} />

    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%8C%99%3C/text%3E%3C/svg%3E"
    />

    <link
      rel="preload"
      href="/fonts/noto-sans-armenian-armenian.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/noto-serif-armenian-armenian.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body class="flex min-h-screen flex-col bg-night-950 font-sans text-slate-200">
    <Header />

    <main class="flex-1">
      <slot />
    </main>

    <Footer />

    <QuickTools />

    <script>
      const revealEls = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
