---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Էջը չի գտնվել (404)" description="Ներեցեք, այս էջը գոյություն չունի:">
  <div class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6">
    <p class="text-6xl" aria-hidden="true">🌙</p>
    <h1 class="mt-4 font-display text-3xl font-bold text-white">Էջը չի գտնվել</h1>
    <p class="mt-3 text-slate-400">Ներեցեք, այս էջը գոյություն չունի:</p>
    <a
      href="/"
      class="mt-6 inline-block rounded-xl bg-gradient-to-r from-violet-500 to-indigo-600 px-6 py-3 font-semibold text-white shadow-lg shadow-violet-900/40 transition hover:from-violet-400 hover:to-indigo-500"
    >
      Գլխավոր էջ
    </a>
  </div>
</Layout>
