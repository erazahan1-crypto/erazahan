---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Ответ на сон — Админка">
  <a href="/admin/dreams/" class="inline-flex min-h-11 items-center text-sm font-semibold text-violet-300 hover:text-white">← К списку снов</a>

  <div class="mt-4" data-loading role="status">Загрузка записи…</div>
  <div class="hidden min-w-0" data-editor>
    <div class="flex min-w-0 flex-wrap items-end justify-between gap-3">
      <div class="min-w-0">
        <p class="break-all text-xs text-slate-500">Запись <span class="font-mono" data-id></span></p>
        <h1 class="mt-1 font-display text-2xl font-bold text-white sm:text-3xl">Сон пользователя</h1>
      </div>
      <span class="rounded-lg border px-3 py-1.5 text-sm font-semibold" data-status></span>
    </div>

    <section class="mt-4 min-w-0 rounded-2xl border border-white/10 bg-white/[0.035] p-4">
      <div class="grid min-w-0 gap-x-5 gap-y-3 sm:grid-cols-2 lg:grid-cols-4">
        <div class="min-w-0"><p class="text-xs uppercase tracking-wide text-slate-500">Имя</p><p class="mt-0.5 break-words text-sm text-white" data-name></p></div>
        <div class="min-w-0"><p class="text-xs uppercase tracking-wide text-slate-500">Email</p><p class="mt-0.5 break-all text-sm text-white" data-email></p></div>
        <div class="min-w-0"><p class="text-xs uppercase tracking-wide text-slate-500">Дата</p><time class="mt-0.5 block text-sm text-white" data-date></time></div>
        <div class="min-w-0"><p class="text-xs uppercase tracking-wide text-slate-500">Уведомление</p><p class="mt-0.5 break-words text-sm" data-notification-status></p></div>
      </div>
      <div class="mt-3 flex min-w-0 flex-col gap-2 border-t border-white/10 pt-3 sm:flex-row sm:flex-wrap sm:items-center">
        <label class="inline-flex min-h-11 min-w-0 cursor-pointer items-center gap-2 text-sm font-semibold text-slate-200">
          <input type="checkbox" data-seo-index class="size-5 shrink-0 accent-violet-500" />
          <span class="break-words">Индексировать страницу</span>
        </label>
        <button type="button" data-seo-save class="min-h-11 w-full rounded-lg border border-violet-400/30 bg-violet-500/10 px-4 text-sm font-semibold text-violet-200 hover:bg-violet-500/20 disabled:opacity-60 sm:w-auto">Сохранить SEO</button>
        <div class="hidden min-w-0 rounded-lg border px-3 py-2 text-sm sm:flex-1" data-seo-message role="status" aria-live="polite"></div>
      </div>
      <div class="mt-3 flex min-w-0 flex-col gap-2 border-t border-white/10 pt-3 sm:flex-row sm:flex-wrap sm:items-center">
        <label class="inline-flex min-h-11 min-w-0 cursor-pointer items-center gap-2 text-sm font-semibold text-slate-200">
          <input type="checkbox" data-featured-home class="size-5 shrink-0 accent-amber-400" />
          <span class="break-words">Показывать на главной</span>
        </label>
        <button type="button" data-featured-save class="min-h-11 w-full rounded-lg border border-amber-300/30 bg-amber-300/10 px-4 text-sm font-semibold text-amber-200 hover:bg-amber-300/15 disabled:opacity-60 sm:w-auto">Сохранить</button>
        <div class="hidden min-w-0 rounded-lg border px-3 py-2 text-sm sm:flex-1" data-featured-message role="status" aria-live="polite"></div>
      </div>
    </section>

    <div class="mt-4 grid min-w-0 items-start gap-4 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
      <section class="min-w-0 rounded-2xl border border-white/10 bg-white/[0.035] p-4 sm:p-5">
        <div class="flex min-w-0 items-center justify-between gap-3">
          <label for="dream-text" class="font-display text-lg font-bold text-white">Текст сна</label>
          <span class="shrink-0 text-xs tabular-nums text-slate-400"><span data-dream-count>0</span>/5000</span>
        </div>
        <textarea id="dream-text" data-dream-text rows="11" minlength="20" maxlength="5000" class="mt-3 min-h-64 w-full max-w-full resize-y rounded-xl border border-white/10 bg-night-950/70 p-3 text-base leading-7 text-white outline-none focus:border-violet-400 focus:ring-2 focus:ring-violet-500/20"></textarea>
        <div class="mt-3 hidden rounded-xl border px-3 py-2 text-sm" data-dream-message role="status" aria-live="polite"></div>
        <button type="button" data-dream-save class="mt-3 min-h-11 w-full rounded-xl bg-violet-600 px-4 text-sm font-semibold text-white transition hover:bg-violet-500 disabled:opacity-60 sm:w-auto">Сохранить текст сна</button>
      </section>

      <section class="min-w-0 rounded-2xl border border-violet-400/20 bg-violet-500/[0.06] p-4 sm:p-5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="font-display text-xl font-bold text-white">Ответ</h2>
          <p class="mt-0.5 text-xs text-slate-400">Markdown без HTML.</p>
        </div>
        <span class="text-sm tabular-nums text-slate-400"><span data-answer-count>0</span>/20000</span>
      </div>

      <textarea data-answer rows="15" maxlength="20000" class="mt-3 min-h-80 w-full max-w-full resize-y rounded-xl border border-white/10 bg-night-950/70 p-3 font-sans text-base leading-7 text-white outline-none focus:border-violet-400 focus:ring-2 focus:ring-violet-500/20" placeholder="Напишите ответ пользователю…"></textarea>

      <button type="button" data-link-toggle class="mt-3 min-h-11 w-full rounded-lg border border-violet-400/30 bg-violet-500/10 px-4 text-sm font-semibold text-violet-200 hover:bg-violet-500/20 sm:w-auto">Добавить ссылку на пост</button>

      <div class="mt-3 hidden min-w-0 rounded-xl border border-white/10 bg-night-950/60 p-3" data-link-panel>
        <label for="post-search" class="text-sm font-semibold text-white">Поиск существующего поста</label>
        <input id="post-search" type="search" placeholder="Выделите текст или введите запрос" class="mt-2 min-h-11 w-full max-w-full rounded-lg border border-white/10 bg-white/5 px-3 text-base text-white outline-none focus:border-violet-400" data-post-search />
        <p class="mt-2 break-words text-xs text-slate-400" data-link-hint>Выберите статью — ссылка будет вставлена в ответ.</p>
        <div class="mt-3 max-h-72 min-w-0 space-y-3 overflow-y-auto" data-post-results></div>
      </div>

      <div class="mt-3 hidden rounded-xl border px-3 py-2 text-sm" data-message role="status" aria-live="polite"></div>

      <div class="mt-4 grid gap-2 sm:flex sm:flex-wrap">
        <button type="button" data-action="draft" class="min-h-12 rounded-xl border border-white/15 bg-white/5 px-5 font-semibold text-white hover:bg-white/10">Сохранить черновик</button>
        <button type="button" data-action="publish" class="min-h-12 rounded-xl bg-emerald-600 px-5 font-semibold text-white hover:bg-emerald-500">Опубликовать</button>
        <button type="button" data-action="resend_notification" class="hidden min-h-12 rounded-xl border border-sky-400/30 bg-sky-500/10 px-5 font-semibold text-sky-200 hover:bg-sky-500/20">Отправить уведомление</button>
      </div>
      </section>
    </div>

    <details class="mt-4 min-w-0 rounded-xl border border-rose-400/20 bg-rose-500/[0.04]">
      <summary class="min-h-11 cursor-pointer px-4 py-3 text-sm font-semibold text-rose-200">Опасные действия</summary>
      <div class="flex min-w-0 flex-col gap-2 border-t border-rose-400/20 p-4 sm:flex-row sm:flex-wrap">
        <button type="button" data-action="reject" class="min-h-11 rounded-lg border border-rose-400/30 px-4 text-sm font-semibold text-rose-300 hover:bg-rose-500/10">Отклонить</button>
        <button type="button" data-action="reopen" class="hidden min-h-11 rounded-lg border border-amber-400/30 px-4 text-sm font-semibold text-amber-200 hover:bg-amber-500/10">Вернуть в новые</button>
        <button type="button" data-delete-dream class="min-h-11 rounded-lg border border-rose-400/50 bg-rose-600 px-4 text-sm font-semibold text-white hover:bg-rose-500 disabled:opacity-60">Удалить навсегда</button>
      </div>
    </details>
  </div>

  <script>
    type Status = 'pending' | 'answered' | 'rejected';
    interface DreamRecord {
      id: string;
      name: string | null;
      email: string;
      dream_text: string;
      status: Status;
      answer_text: string | null;
      created_at: string;
      answered_at: string | null;
      notification_sent_at: string | null;
      seo_index: number | null;
      featured_home: number | null;
    }
    interface SearchItem { slug: string; title: string; text?: string; match?: 'exact' | 'close' | 'partial'; score?: number }

    const loading = document.querySelector<HTMLElement>('[data-loading]');
    const editor = document.querySelector<HTMLElement>('[data-editor]');
    const dreamText = document.querySelector<HTMLTextAreaElement>('[data-dream-text]');
    const dreamCount = document.querySelector<HTMLElement>('[data-dream-count]');
    const dreamMessage = document.querySelector<HTMLElement>('[data-dream-message]');
    const dreamSave = document.querySelector<HTMLButtonElement>('[data-dream-save]');
    const seoIndex = document.querySelector<HTMLInputElement>('[data-seo-index]');
    const seoSave = document.querySelector<HTMLButtonElement>('[data-seo-save]');
    const seoMessage = document.querySelector<HTMLElement>('[data-seo-message]');
    const featuredHome = document.querySelector<HTMLInputElement>('[data-featured-home]');
    const featuredSave = document.querySelector<HTMLButtonElement>('[data-featured-save]');
    const featuredMessage = document.querySelector<HTMLElement>('[data-featured-message]');
    const answer = document.querySelector<HTMLTextAreaElement>('[data-answer]');
    const count = document.querySelector<HTMLElement>('[data-answer-count]');
    const message = document.querySelector<HTMLElement>('[data-message]');
    const actionButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-action]')];
    const deleteDreamButton = document.querySelector<HTMLButtonElement>('[data-delete-dream]');
    const linkPanel = document.querySelector<HTMLElement>('[data-link-panel]');
    const postSearch = document.querySelector<HTMLInputElement>('[data-post-search]');
    const postResults = document.querySelector<HTMLElement>('[data-post-results]');
    const id = decodeURIComponent(location.pathname.replace(/\/$/, '').split('/').pop() || '');
    let currentStatus: Status | null = null;
    let linkSelectionStart = 0;
    let linkSelectionEnd = 0;
    let linkSelectionText = '';
    let linkSearchTimer = 0;
    let linkSearchSequence = 0;

    async function loadDream() {
      try {
        const response = await fetch(`/api/admin/dreams/${encodeURIComponent(id)}`);
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || 'Не удалось загрузить запись.');
        fillEditor(result.dream as DreamRecord);
        if (loading) loading.hidden = true;
        editor?.classList.remove('hidden');
      } catch (error) {
        if (loading) {
          loading.textContent = error instanceof Error ? error.message : 'Не удалось загрузить запись.';
          loading.className = 'rounded-xl border border-rose-400/30 bg-rose-500/10 p-4 text-rose-200';
        }
      }
    }

    function fillEditor(dream: DreamRecord) {
      currentStatus = dream.status;
      if (seoIndex) seoIndex.checked = dream.seo_index === 1;
      if (featuredHome) featuredHome.checked = dream.featured_home === 1;
      setText('[data-id]', dream.id);
      setText('[data-name]', dream.name || 'Без имени');
      setText('[data-email]', dream.email);
      if (dreamText) dreamText.value = dream.dream_text;
      updateDreamCount();
      const date = document.querySelector<HTMLTimeElement>('[data-date]');
      if (date) {
        date.dateTime = dream.created_at;
        date.textContent = formatDate(dream.created_at);
      }
      if (answer) answer.value = dream.answer_text || '';
      updateCount();
      updateStatus(dream.status);
      updateNotificationStatus(dream);
    }


    async function saveDreamText() {
      if (!dreamText || !dreamSave) return;
      const value = dreamText.value.trim();
      if (value.length < 20) {
        showDreamMessage('Текст сна должен содержать не менее 20 символов.', 'error');
        return;
      }

      dreamSave.disabled = true;
      showDreamMessage('Сохранение…', 'neutral');
      try {
        const response = await fetch(`/api/admin/dreams/${encodeURIComponent(id)}`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ action: 'update_dream', dream_text: value }),
        });
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || 'Не удалось сохранить текст сна.');
        dreamText.value = result.dream.dream_text;
        updateDreamCount();
        showDreamMessage('Текст сна сохранён', 'success');
      } catch (error) {
        showDreamMessage(error instanceof Error ? error.message : 'Не удалось сохранить текст сна.', 'error');
      } finally {
        dreamSave.disabled = false;
      }
    }

    async function saveSeoIndex() {
      if (!seoIndex || !seoSave) return;
      seoSave.disabled = true;
      if (seoMessage) {
        seoMessage.textContent = 'Сохранение…';
        seoMessage.className = 'mt-4 rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-slate-300';
      }
      try {
        const response = await fetch(`/api/admin/dreams/${encodeURIComponent(id)}`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ action: 'update_seo_index', seo_index: seoIndex.checked }),
        });
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || 'Не удалось сохранить SEO-настройку.');
        if (seoIndex) seoIndex.checked = result.dream.seo_index === 1;
        if (seoMessage) {
          seoMessage.textContent = 'SEO-настройка сохранена.';
          seoMessage.className = 'mt-4 rounded-xl border border-emerald-400/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-200';
        }
      } catch (error) {
        if (seoMessage) {
          seoMessage.textContent = error instanceof Error ? error.message : 'Не удалось сохранить SEO-настройку.';
          seoMessage.className = 'mt-4 rounded-xl border border-rose-400/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-200';
        }
      } finally {
        seoSave.disabled = false;
      }
    }

    async function saveFeaturedHome() {
      if (!featuredHome || !featuredSave) return;
      featuredSave.disabled = true;
      showFeaturedMessage('Сохранение…', 'neutral');
      try {
        const response = await fetch(`/api/admin/dreams/${encodeURIComponent(id)}`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ action: 'update_featured_home', featured_home: featuredHome.checked }),
        });
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || 'Не удалось сохранить настройку главной.');
        featuredHome.checked = result.dream.featured_home === 1;
        showFeaturedMessage('Настройка главной сохранена.', 'success');
      } catch (error) {
        showFeaturedMessage(error instanceof Error ? error.message : 'Не удалось сохранить настройку главной.', 'error');
      } finally {
        featuredSave.disabled = false;
      }
    }

    function updateStatus(status: Status) {
      const element = document.querySelector<HTMLElement>('[data-status]');
      if (element) {
        element.textContent = status === 'pending' ? 'Новый' : status === 'answered' ? 'Отвечен' : 'Отклонён';
        element.className = status === 'pending'
          ? 'rounded-lg border border-amber-400/30 bg-amber-500/10 px-3 py-1.5 text-sm font-semibold text-amber-200'
          : status === 'answered'
            ? 'rounded-lg border border-emerald-400/30 bg-emerald-500/10 px-3 py-1.5 text-sm font-semibold text-emerald-200'
            : 'rounded-lg border border-rose-400/30 bg-rose-500/10 px-3 py-1.5 text-sm font-semibold text-rose-200';
      }
      const reopen = document.querySelector<HTMLButtonElement>('[data-action="reopen"]');
      reopen?.classList.toggle('hidden', status === 'pending');
    }

    function updateNotificationStatus(dream: DreamRecord) {
      const element = document.querySelector<HTMLElement>('[data-notification-status]');
      if (element) {
        element.textContent = dream.notification_sent_at
          ? `Email отправлен: ${formatDate(dream.notification_sent_at)}`
          : 'Email не отправлен';
        element.className = dream.notification_sent_at
          ? 'mt-1 text-emerald-300'
          : 'mt-1 text-amber-200';
      }

      const resend = document.querySelector<HTMLButtonElement>('[data-action="resend_notification"]');
      if (resend) {
        resend.classList.toggle('hidden', dream.status !== 'answered' || !dream.email.trim());
        resend.textContent = dream.notification_sent_at ? 'Отправить email повторно' : 'Отправить уведомление';
      }
    }

    async function save(action: string) {
      if (!answer) return;
      if (action === 'reject' && !confirm('Отклонить эту запись? Она не будет опубликована.')) return;
      if (action === 'publish' && !confirm('Опубликовать ответ и отметить запись отвеченной?')) return;
      if (action === 'resend_notification' && !confirm('Отправить пользователю email со ссылкой на опубликованный ответ?')) return;
      setBusy(true);
      showMessage('Сохранение…', 'neutral');
      try {
        const response = await fetch(`/api/admin/dreams/${encodeURIComponent(id)}`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ action, answer_text: answer.value }),
        });
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || 'Не удалось сохранить изменения.');
        fillEditor(result.dream as DreamRecord);
        if (result.warning) {
          showMessage(result.warning, 'warning');
        } else {
          showMessage(action === 'draft' ? 'Черновик сохранён.' : action === 'publish' ? 'Ответ опубликован.' : action === 'resend_notification' ? 'Email отправлен.' : action === 'reject' ? 'Запись отклонена.' : 'Запись возвращена в новые.', 'success');
        }
      } catch (error) {
        showMessage(error instanceof Error ? error.message : 'Не удалось сохранить изменения.', 'error');
      } finally {
        setBusy(false);
      }
    }

    async function deleteDream() {
      const warning = currentStatus === 'answered'
        ? 'Удалить этот сон и все связанные с ним данные навсегда? Это действие нельзя отменить.\n\nОпубликованная страница этого сна также перестанет быть доступна.'
        : 'Удалить этот сон и все связанные с ним данные навсегда? Это действие нельзя отменить.';
      if (!confirm(warning)) return;

      setBusy(true);
      if (deleteDreamButton) deleteDreamButton.disabled = true;
      try {
        const response = await fetch(`/api/admin/dreams/${encodeURIComponent(id)}`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ action: 'delete_dream' }),
        });
        const result = await response.json();
        if (!response.ok || !result.ok || !result.deleted) throw new Error(result.error || 'Не удалось удалить запись.');
        window.location.assign('/admin/dreams/?deleted=1');
      } catch (error) {
        if (deleteDreamButton) deleteDreamButton.disabled = false;
        setBusy(false);
        showMessage(error instanceof Error ? error.message : 'Не удалось удалить запись.', 'error');
      }
    }

    function setBusy(busy: boolean) {
      actionButtons.forEach((button) => { button.disabled = busy; });
    }

    function showMessage(text: string, kind: 'success' | 'warning' | 'error' | 'neutral') {
      if (!message) return;
      message.textContent = text;
      message.className = kind === 'success'
        ? 'mt-4 rounded-xl border border-emerald-400/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-200'
        : kind === 'warning'
          ? 'mt-4 rounded-xl border border-amber-400/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-200'
          : kind === 'error'
          ? 'mt-4 rounded-xl border border-rose-400/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-200'
          : 'mt-4 rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-slate-300';
    }

    function showDreamMessage(text: string, kind: 'success' | 'error' | 'neutral') {
      if (!dreamMessage) return;
      dreamMessage.textContent = text;
      dreamMessage.className = kind === 'success'
        ? 'mt-4 rounded-xl border border-emerald-400/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-200'
        : kind === 'error'
          ? 'mt-4 rounded-xl border border-rose-400/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-200'
          : 'mt-4 rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-slate-300';
    }

    function showFeaturedMessage(text: string, kind: 'success' | 'error' | 'neutral') {
      if (!featuredMessage) return;
      featuredMessage.textContent = text;
      featuredMessage.className = kind === 'success'
        ? 'rounded-lg border border-emerald-400/30 bg-emerald-500/10 px-3 py-2 text-sm text-emerald-200 sm:flex-1'
        : kind === 'error'
          ? 'rounded-lg border border-rose-400/30 bg-rose-500/10 px-3 py-2 text-sm text-rose-200 sm:flex-1'
          : 'rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm text-slate-300 sm:flex-1';
    }


    function openLinkSearch() {
      if (!answer || !postSearch || !linkPanel) return;
      linkSelectionStart = answer.selectionStart;
      linkSelectionEnd = answer.selectionEnd;
      linkSelectionText = answer.value.slice(linkSelectionStart, linkSelectionEnd);
      postSearch.value = linkSelectionText.trim();
      linkPanel.classList.remove('hidden');
      setText(
        '[data-link-hint]',
        linkSelectionText
          ? `Ищем статью для выделения «${linkSelectionText}».`
          : 'Введите запрос вручную. Название выбранной статьи станет текстом ссылки.',
      );
      postSearch.focus();
      if (postSearch.value) postSearch.select();
      void searchPosts();
    }

    async function searchPosts() {
      if (!postResults) return;
      const query = postSearch?.value.trim() || '';
      const sequence = ++linkSearchSequence;
      postResults.replaceChildren();
      if (query.length < 2) {
        appendResultMessage('Введите минимум два символа.');
        return;
      }

      appendResultMessage('Поиск…');
      try {
        const response = await fetch(`/api/admin/dream-symbols/${encodeURIComponent(id)}?action=search&q=${encodeURIComponent(query)}`);
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || 'Не удалось выполнить поиск.');
        if (sequence !== linkSearchSequence) return;
        renderPostResults(result.results as SearchItem[]);
      } catch (error) {
        if (sequence !== linkSearchSequence) return;
        postResults.replaceChildren();
        appendResultMessage(error instanceof Error ? error.message : 'Не удалось выполнить поиск.', true);
      }
    }

    function renderPostResults(items: SearchItem[]) {
      if (!postResults) return;
      postResults.replaceChildren();
      if (!items.length) {
        appendResultMessage('Подходящие статьи не найдены.');
        return;
      }

      const exact = items.filter((item) => item.match === 'exact');
      const other = items.filter((item) => item.match !== 'exact');
      if (exact.length) appendResultGroup('Точные совпадения', exact);
      if (other.length) appendResultGroup(exact.length ? 'Другие совпадения' : 'Лучшие совпадения', other);
    }

    function appendResultGroup(label: string, items: SearchItem[]) {
      if (!postResults) return;
      const group = document.createElement('section');
      group.className = 'min-w-0 space-y-2';
      const heading = document.createElement('h3');
      heading.className = 'text-xs font-semibold uppercase tracking-wide text-slate-400';
      heading.textContent = label;
      group.append(heading);
      items.forEach((item) => group.append(makePostResult(item)));
      postResults.append(group);
    }

    function makePostResult(item: SearchItem) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'block min-h-11 w-full min-w-0 rounded-lg border border-white/10 bg-white/5 p-3 text-left hover:border-violet-400/40 hover:bg-white/10';
      const row = document.createElement('span');
      row.className = 'flex min-w-0 flex-wrap items-center gap-2';
      const title = document.createElement('span');
      title.className = 'min-w-0 break-words font-semibold text-white';
      title.textContent = item.title;
      const badge = document.createElement('span');
      badge.className = item.match === 'exact'
        ? 'rounded-full bg-emerald-500/15 px-2 py-0.5 text-xs text-emerald-200'
        : 'rounded-full bg-amber-500/15 px-2 py-0.5 text-xs text-amber-200';
      badge.textContent = item.match === 'exact' ? 'Точное' : item.match === 'close' ? 'Близкое' : 'Частичное';
      const path = document.createElement('span');
      path.className = 'mt-1 block break-all text-xs text-slate-400';
      path.textContent = `/${item.slug}/`;
      row.append(title, badge);
      button.append(row, path);
      button.addEventListener('click', () => insertPostLink(item));
      return button;
    }

    function insertPostLink(item: SearchItem) {
      if (!answer || !isSafePostSlug(item.slug)) {
        if (postResults) {
          postResults.replaceChildren();
          appendResultMessage('Нельзя вставить ссылку с некорректным адресом.', true);
        }
        return;
      }

      const start = Math.min(linkSelectionStart, answer.value.length);
      const end = Math.min(Math.max(linkSelectionEnd, start), answer.value.length);
      const currentSelection = answer.value.slice(start, end);
      const label = currentSelection === linkSelectionText && currentSelection ? currentSelection : item.title;
      const safeLabel = label.replace(/([\\[\]])/g, '\\$1');
      answer.setRangeText(`[${safeLabel}](/${item.slug}/)`, start, end, 'end');
      answer.focus();
      updateCount();
      linkPanel?.classList.add('hidden');
      postResults?.replaceChildren();
    }

    function isSafePostSlug(slug: string) {
      return Boolean(
        slug
        && slug.length <= 300
        && !slug.includes('/')
        && !/[\s?#]/u.test(slug)
        && !/^(?:https?:|javascript:)/iu.test(slug),
      );
    }

    function appendResultMessage(text: string, error = false) {
      if (!postResults) return;
      const message = document.createElement('p');
      message.className = error ? 'break-words text-sm text-rose-200' : 'break-words text-sm text-slate-400';
      message.textContent = text;
      postResults.append(message);
    }

    function setText(selector: string, value: string) {
      const element = document.querySelector<HTMLElement>(selector);
      if (element) element.textContent = value;
    }
    function updateDreamCount() { if (dreamText && dreamCount) dreamCount.textContent = String(dreamText.value.length); }
    function updateCount() { if (answer && count) count.textContent = String(answer.value.length); }
    function formatDate(value: string) {
      const date = new Date(value);
      return Number.isNaN(date.getTime()) ? value : date.toLocaleString('ru-RU', { dateStyle: 'long', timeStyle: 'short' });
    }

    dreamText?.addEventListener('input', updateDreamCount);
    dreamSave?.addEventListener('click', saveDreamText);
    seoSave?.addEventListener('click', saveSeoIndex);
    featuredSave?.addEventListener('click', saveFeaturedHome);
    answer?.addEventListener('input', updateCount);
    document.querySelector('[data-link-toggle]')?.addEventListener('click', openLinkSearch);
    postSearch?.addEventListener('input', () => {
      window.clearTimeout(linkSearchTimer);
      linkSearchTimer = window.setTimeout(searchPosts, 250);
    });
    actionButtons.forEach((button) => button.addEventListener('click', () => save(button.dataset.action || '')));
    deleteDreamButton?.addEventListener('click', deleteDream);
    loadDream();
  </script>
</AdminLayout>
