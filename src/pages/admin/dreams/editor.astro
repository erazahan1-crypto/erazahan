---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Ответ на сон — Админка">
  <a href="/admin/dreams/" class="inline-flex min-h-11 items-center text-sm font-semibold text-violet-300 hover:text-white">← К списку снов</a>

  <div class="mt-4" data-loading role="status">Загрузка записи…</div>
  <div class="hidden" data-editor>
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-sm text-slate-400">Запись <span class="font-mono" data-id></span></p>
        <h1 class="mt-1 font-display text-3xl font-bold text-white">Сон пользователя</h1>
      </div>
      <span class="rounded-lg border px-3 py-1.5 text-sm font-semibold" data-status></span>
    </div>

    <section class="mt-6 grid gap-4 rounded-2xl border border-white/10 bg-white/[0.035] p-5 sm:grid-cols-2 lg:grid-cols-4">
      <div><p class="text-xs uppercase tracking-wide text-slate-500">Имя</p><p class="mt-1 text-white" data-name></p></div>
      <div><p class="text-xs uppercase tracking-wide text-slate-500">Email</p><p class="mt-1 break-all text-white" data-email></p></div>
      <div><p class="text-xs uppercase tracking-wide text-slate-500">Дата</p><time class="mt-1 block text-white" data-date></time></div>
      <div><p class="text-xs uppercase tracking-wide text-slate-500">Уведомление</p><p class="mt-1 text-white" data-notification-status></p></div>
    </section>

    <section class="mt-5 rounded-2xl border border-violet-400/20 bg-violet-500/[0.06] p-5 sm:p-6">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h2 class="font-display text-xl font-bold text-white">SEO</h2>
          <p class="mt-1 max-w-2xl text-sm leading-6 text-slate-400">Включайте только для содержательных и уникальных снов с хорошим ответом.</p>
        </div>
        <label class="inline-flex min-h-11 cursor-pointer items-center gap-3 text-sm font-semibold text-slate-200">
          <input type="checkbox" data-seo-index class="size-5 accent-violet-500" />
          <span>Индексировать страницу в поиске</span>
        </label>
      </div>
      <div class="mt-4 hidden rounded-xl border px-4 py-3 text-sm" data-seo-message role="status" aria-live="polite"></div>
      <button type="button" data-seo-save class="mt-4 min-h-12 rounded-xl bg-violet-600 px-5 font-semibold text-white transition hover:bg-violet-500 disabled:cursor-wait disabled:opacity-60">Сохранить SEO</button>
    </section>

    <section class="mt-5 rounded-2xl border border-white/10 bg-white/[0.035] p-5 sm:p-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <label for="dream-text" class="font-display text-xl font-bold text-white">Текст сна</label>
          <p class="mt-1 text-sm text-slate-400">Исправьте орфографию или замените латиницу армянским текстом.</p>
        </div>
        <span class="text-sm tabular-nums text-slate-400"><span data-dream-count>0</span>/5000</span>
      </div>
      <textarea id="dream-text" data-dream-text rows="10" minlength="20" maxlength="5000" class="mt-4 min-h-56 w-full resize-y rounded-xl border border-white/10 bg-night-950/70 p-4 text-base leading-7 text-white outline-none focus:border-violet-400 focus:ring-2 focus:ring-violet-500/20"></textarea>
      <div class="mt-4 hidden rounded-xl border px-4 py-3 text-sm" data-dream-message role="status" aria-live="polite"></div>
      <button type="button" data-dream-save class="mt-4 min-h-12 rounded-xl bg-violet-600 px-5 font-semibold text-white transition hover:bg-violet-500 disabled:cursor-wait disabled:opacity-60">Сохранить текст сна</button>
    </section>

    <section class="mt-5 min-w-0 rounded-2xl border border-violet-400/20 bg-violet-500/[0.06] p-5 sm:p-6">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 class="font-display text-xl font-bold text-white">Символы сна</h2>
          <p class="mt-1 max-w-2xl text-sm leading-6 text-slate-400">Свяжите каждый ключевой символ с точной существующей статьёй сонника. Предложения сохраняются только после вашего подтверждения.</p>
        </div>
        <button type="button" data-symbol-suggest class="min-h-11 rounded-xl border border-violet-400/30 bg-violet-500/10 px-4 text-sm font-semibold text-violet-200 hover:bg-violet-500/20 disabled:opacity-60">Предложить символы</button>
      </div>

      <div class="mt-5 grid min-w-0 gap-4 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
        <div class="min-w-0">
          <label for="symbol-text" class="text-sm font-semibold text-white">Символ</label>
          <input id="symbol-text" data-symbol-text maxlength="120" placeholder="Например: օձ" class="mt-2 min-h-11 w-full max-w-full rounded-lg border border-white/10 bg-night-950/70 px-3 text-base text-white outline-none focus:border-violet-400" />
        </div>
        <div class="min-w-0">
          <label for="symbol-search" class="text-sm font-semibold text-white">Найти статью</label>
          <input id="symbol-search" data-symbol-search type="search" placeholder="Введите название символа" class="mt-2 min-h-11 w-full max-w-full rounded-lg border border-white/10 bg-night-950/70 px-3 text-base text-white outline-none focus:border-violet-400" />
        </div>
      </div>
      <div class="mt-3 hidden max-h-80 min-w-0 space-y-2 overflow-y-auto rounded-xl border border-white/10 bg-night-950/60 p-3" data-symbol-results></div>
      <div class="mt-3 hidden min-w-0 rounded-xl border border-violet-400/20 bg-violet-500/10 p-4" data-symbol-selection></div>
      <button type="button" data-symbol-add disabled class="mt-3 min-h-11 rounded-xl bg-violet-600 px-4 text-sm font-semibold text-white hover:bg-violet-500 disabled:cursor-not-allowed disabled:opacity-50">Добавить символ</button>
      <p class="mt-3 hidden rounded-xl border px-4 py-3 text-sm" data-symbol-message role="status" aria-live="polite"></p>

      <h3 class="mt-6 font-semibold text-white">Подтверждённые символы</h3>
      <div class="mt-3 min-w-0 space-y-3" data-symbol-links></div>
    </section>

    <section class="mt-5 rounded-2xl border border-white/10 bg-white/[0.035] p-5 sm:p-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="font-display text-xl font-bold text-white">Ответ</h2>
          <p class="mt-1 text-sm text-slate-400">Простой Markdown. HTML не допускается.</p>
        </div>
        <span class="text-sm tabular-nums text-slate-400"><span data-answer-count>0</span>/20000</span>
      </div>

      <div class="mt-4 flex flex-wrap gap-2" role="toolbar" aria-label="Форматирование ответа">
        <button type="button" data-format="bold" class="min-h-10 rounded-lg border border-white/10 bg-white/5 px-3 text-sm font-semibold hover:bg-white/10">Жирный</button>
        <button type="button" data-format="list" class="min-h-10 rounded-lg border border-white/10 bg-white/5 px-3 text-sm font-semibold hover:bg-white/10">Список</button>
        <button type="button" data-link-toggle class="min-h-10 rounded-lg border border-violet-400/30 bg-violet-500/10 px-3 text-sm font-semibold text-violet-200 hover:bg-violet-500/20">Добавить ссылку на пост</button>
      </div>

      <div class="mt-3 hidden rounded-xl border border-white/10 bg-night-950/60 p-4" data-link-panel>
        <label for="post-search" class="text-sm font-semibold text-white">Поиск существующего поста</label>
        <input id="post-search" type="search" placeholder="Название или адрес поста" class="mt-2 min-h-11 w-full rounded-lg border border-white/10 bg-white/5 px-3 text-base text-white outline-none focus:border-violet-400" data-post-search />
        <p class="mt-2 text-xs text-slate-400">Выбранный пост будет вставлен в редактор как внутренняя Markdown-ссылка.</p>
        <div class="mt-3 max-h-64 space-y-2 overflow-y-auto" data-post-results></div>
      </div>

      <textarea data-answer rows="16" maxlength="20000" class="mt-4 min-h-80 w-full resize-y rounded-xl border border-white/10 bg-night-950/70 p-4 font-sans text-base leading-7 text-white outline-none focus:border-violet-400 focus:ring-2 focus:ring-violet-500/20" placeholder="Напишите ответ пользователю…"></textarea>

      <div class="mt-4 hidden rounded-xl border px-4 py-3 text-sm" data-message role="status" aria-live="polite"></div>

      <div class="mt-5 flex flex-wrap gap-3">
        <button type="button" data-action="draft" class="min-h-12 rounded-xl border border-white/15 bg-white/5 px-5 font-semibold text-white hover:bg-white/10">Сохранить черновик</button>
        <button type="button" data-action="publish" class="min-h-12 rounded-xl bg-emerald-600 px-5 font-semibold text-white hover:bg-emerald-500">Опубликовать ответ</button>
        <button type="button" data-action="reject" class="min-h-12 rounded-xl border border-rose-400/30 px-5 font-semibold text-rose-300 hover:bg-rose-500/10">Отклонить</button>
        <button type="button" data-action="reopen" class="hidden min-h-12 rounded-xl border border-amber-400/30 px-5 font-semibold text-amber-200 hover:bg-amber-500/10">Вернуть в новые</button>
        <button type="button" data-action="resend_notification" class="hidden min-h-12 rounded-xl border border-sky-400/30 bg-sky-500/10 px-5 font-semibold text-sky-200 hover:bg-sky-500/20">Отправить уведомление</button>
      </div>
      <p class="mt-4 text-xs text-slate-500">AI-черновик зарезервирован в структуре данных, но генерация AI на этом этапе отключена.</p>
    </section>

    <section class="mt-8 rounded-2xl border border-rose-400/30 bg-rose-500/[0.06] p-5 sm:p-6">
      <h2 class="font-display text-xl font-bold text-rose-100">Опасная зона</h2>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-rose-200/80">Удаление навсегда стирает запись и все связанные с ней данные. Это действие нельзя отменить.</p>
      <button type="button" data-delete-dream class="mt-5 min-h-12 rounded-xl border border-rose-400/50 bg-rose-600 px-5 font-semibold text-white hover:bg-rose-500 disabled:cursor-wait disabled:opacity-60">Удалить навсегда</button>
    </section>
  </div>

  <script>
    type Status = 'pending' | 'answered' | 'rejected';
    interface DreamRecord {
      id: string;
      name: string | null;
      email: string;
      dream_text: string;
      status: Status;
      answer_text: string | null;
      created_at: string;
      answered_at: string | null;
      notification_sent_at: string | null;
      seo_index: number | null;
    }
    interface SearchItem { slug: string; title: string; text?: string; match?: 'exact' | 'close' | 'partial'; score?: number }
    interface SymbolLink { id: string; symbol_text: string; post_slug: string; post_title: string; created_at: string }

    const loading = document.querySelector<HTMLElement>('[data-loading]');
    const editor = document.querySelector<HTMLElement>('[data-editor]');
    const dreamText = document.querySelector<HTMLTextAreaElement>('[data-dream-text]');
    const dreamCount = document.querySelector<HTMLElement>('[data-dream-count]');
    const dreamMessage = document.querySelector<HTMLElement>('[data-dream-message]');
    const dreamSave = document.querySelector<HTMLButtonElement>('[data-dream-save]');
    const seoIndex = document.querySelector<HTMLInputElement>('[data-seo-index]');
    const seoSave = document.querySelector<HTMLButtonElement>('[data-seo-save]');
    const seoMessage = document.querySelector<HTMLElement>('[data-seo-message]');
    const answer = document.querySelector<HTMLTextAreaElement>('[data-answer]');
    const count = document.querySelector<HTMLElement>('[data-answer-count]');
    const message = document.querySelector<HTMLElement>('[data-message]');
    const actionButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-action]')];
    const deleteDreamButton = document.querySelector<HTMLButtonElement>('[data-delete-dream]');
    const symbolText = document.querySelector<HTMLInputElement>('[data-symbol-text]');
    const symbolSearch = document.querySelector<HTMLInputElement>('[data-symbol-search]');
    const symbolResults = document.querySelector<HTMLElement>('[data-symbol-results]');
    const symbolSelection = document.querySelector<HTMLElement>('[data-symbol-selection]');
    const symbolAdd = document.querySelector<HTMLButtonElement>('[data-symbol-add]');
    const symbolSuggest = document.querySelector<HTMLButtonElement>('[data-symbol-suggest]');
    const symbolMessage = document.querySelector<HTMLElement>('[data-symbol-message]');
    const symbolLinks = document.querySelector<HTMLElement>('[data-symbol-links]');
    const linkPanel = document.querySelector<HTMLElement>('[data-link-panel]');
    const postSearch = document.querySelector<HTMLInputElement>('[data-post-search]');
    const postResults = document.querySelector<HTMLElement>('[data-post-results]');
    const id = decodeURIComponent(location.pathname.replace(/\/$/, '').split('/').pop() || '');
    let searchIndex: SearchItem[] | null = null;
    let currentStatus: Status | null = null;
    let selectedSymbolPost: SearchItem | null = null;
    let symbolSearchTimer = 0;
    let symbolSearchSequence = 0;

    async function loadDream() {
      try {
        const response = await fetch(`/api/admin/dreams/${encodeURIComponent(id)}`);
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || 'Не удалось загрузить запись.');
        fillEditor(result.dream as DreamRecord);
        await loadSymbolLinks();
        if (loading) loading.hidden = true;
        editor?.classList.remove('hidden');
      } catch (error) {
        if (loading) {
          loading.textContent = error instanceof Error ? error.message : 'Не удалось загрузить запись.';
          loading.className = 'rounded-xl border border-rose-400/30 bg-rose-500/10 p-4 text-rose-200';
        }
      }
    }

    function fillEditor(dream: DreamRecord) {
      currentStatus = dream.status;
      if (seoIndex) seoIndex.checked = dream.seo_index === 1;
      setText('[data-id]', dream.id);
      setText('[data-name]', dream.name || 'Без имени');
      setText('[data-email]', dream.email);
      if (dreamText) dreamText.value = dream.dream_text;
      updateDreamCount();
      const date = document.querySelector<HTMLTimeElement>('[data-date]');
      if (date) {
        date.dateTime = dream.created_at;
        date.textContent = formatDate(dream.created_at);
      }
      if (answer) answer.value = dream.answer_text || '';
      updateCount();
      updateStatus(dream.status);
      updateNotificationStatus(dream);
    }

    async function symbolRequest(query = '') {
      const response = await fetch(`/api/admin/dream-symbols/${encodeURIComponent(id)}${query}`);
      const result = await response.json();
      if (!response.ok || !result.ok) throw new Error(result.error || 'Не удалось загрузить символы сна.');
      return result;
    }

    async function loadSymbolLinks() {
      try {
        const result = await symbolRequest();
        renderSymbolLinks(result.links as SymbolLink[]);
      } catch (error) {
        showSymbolMessage(error instanceof Error ? error.message : 'Не удалось загрузить символы сна.', 'error');
      }
    }

    function renderSymbolLinks(links: SymbolLink[]) {
      if (!symbolLinks) return;
      symbolLinks.replaceChildren();
      if (!links.length) {
        const empty = document.createElement('p');
        empty.className = 'text-sm text-slate-400';
        empty.textContent = 'Подтверждённых символов пока нет.';
        symbolLinks.append(empty);
        return;
      }
      links.forEach((link) => {
        const card = document.createElement('article');
        card.className = 'min-w-0 rounded-xl border border-white/10 bg-white/[0.035] p-4';
        const symbol = document.createElement('p');
        symbol.className = 'break-words text-sm font-semibold text-violet-200';
        symbol.textContent = `Символ: ${link.symbol_text}`;
        const title = document.createElement('p');
        title.className = 'mt-1 break-words font-semibold text-white';
        title.textContent = link.post_title;
        const path = document.createElement('a');
        path.href = `/${encodeURIComponent(link.post_slug)}/`;
        path.target = '_blank';
        path.rel = 'noopener';
        path.className = 'mt-1 block break-all text-sm text-slate-400 underline hover:text-white';
        path.textContent = `/${link.post_slug}/`;
        const actions = document.createElement('div');
        actions.className = 'mt-3 flex flex-wrap gap-2';
        const preview = makeButton('Показать толкование', 'border-violet-400/30 text-violet-200');
        const remove = makeButton('Удалить', 'border-rose-400/30 text-rose-200');
        const previewBox = document.createElement('div');
        previewBox.className = 'mt-3 hidden whitespace-pre-wrap break-words rounded-lg border border-white/10 bg-night-950/60 p-3 text-sm leading-6 text-slate-300';
        preview.addEventListener('click', () => togglePreview(link.post_slug, previewBox, preview));
        remove.addEventListener('click', () => deleteSymbolLink(link.id));
        actions.append(preview, remove);
        card.append(symbol, title, path, actions, previewBox);
        symbolLinks.append(card);
      });
    }

    function makeButton(label: string, colors: string) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = `min-h-11 rounded-lg border px-3 text-sm font-semibold hover:bg-white/10 ${colors}`;
      button.textContent = label;
      return button;
    }

    async function searchSymbols() {
      const query = symbolSearch?.value.trim() || '';
      const sequence = ++symbolSearchSequence;
      if (query.length < 2) {
        symbolResults?.classList.add('hidden');
        return;
      }
      try {
        const result = await symbolRequest(`?action=search&q=${encodeURIComponent(query)}`);
        if (sequence !== symbolSearchSequence) return;
        renderSymbolResults(result.results as SearchItem[]);
      } catch (error) {
        if (sequence !== symbolSearchSequence) return;
        showSymbolMessage(error instanceof Error ? error.message : 'Не удалось выполнить поиск.', 'error');
      }
    }

    function renderSymbolResults(items: SearchItem[], suggestedSymbols?: Map<string, string>) {
      if (!symbolResults) return;
      symbolResults.replaceChildren();
      symbolResults.classList.remove('hidden');
      if (!items.length) {
        const empty = document.createElement('p');
        empty.className = 'text-sm text-slate-400';
        empty.textContent = 'Подходящие статьи не найдены.';
        symbolResults.append(empty);
        return;
      }
      items.forEach((item) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'block min-h-11 w-full min-w-0 rounded-lg border border-white/10 bg-white/5 p-3 text-left hover:border-violet-400/40 hover:bg-white/10';
        const heading = document.createElement('span');
        heading.className = 'flex min-w-0 flex-wrap items-center gap-2';
        const title = document.createElement('span');
        title.className = 'min-w-0 break-words font-semibold text-white';
        title.textContent = item.title;
        const badge = document.createElement('span');
        badge.className = item.match === 'exact' ? 'rounded-full bg-emerald-500/15 px-2 py-0.5 text-xs text-emerald-200' : 'rounded-full bg-amber-500/15 px-2 py-0.5 text-xs text-amber-200';
        badge.textContent = item.match === 'exact' ? 'Точное совпадение' : item.match === 'close' ? 'Близкое совпадение' : 'Частичное совпадение';
        const path = document.createElement('span');
        path.className = 'mt-1 block break-all text-xs text-slate-400';
        path.textContent = `/${item.slug}/`;
        heading.append(title, badge);
        button.append(heading, path);
        button.addEventListener('click', () => selectSymbolPost(item, suggestedSymbols?.get(item.slug)));
        symbolResults.append(button);
      });
    }

    function selectSymbolPost(item: SearchItem, suggestedSymbol?: string) {
      selectedSymbolPost = item;
      if (suggestedSymbol && symbolText) symbolText.value = suggestedSymbol;
      if (symbolSelection) {
        symbolSelection.replaceChildren();
        const title = document.createElement('p');
        title.className = 'break-words font-semibold text-white';
        title.textContent = item.title;
        const path = document.createElement('p');
        path.className = 'mt-1 break-all text-xs text-slate-400';
        path.textContent = `/${item.slug}/`;
        const preview = makeButton('Показать толкование', 'mt-3 border-violet-400/30 text-violet-200');
        const previewBox = document.createElement('div');
        previewBox.className = 'mt-3 hidden whitespace-pre-wrap break-words text-sm leading-6 text-slate-300';
        preview.addEventListener('click', () => togglePreview(item.slug, previewBox, preview));
        symbolSelection.append(title, path, preview, previewBox);
        symbolSelection.classList.remove('hidden');
      }
      if (symbolAdd) symbolAdd.disabled = !(symbolText?.value.trim());
      symbolResults?.classList.add('hidden');
    }

    async function togglePreview(slug: string, box: HTMLElement, button: HTMLButtonElement) {
      if (box.dataset.loaded === '1') {
        box.classList.toggle('hidden');
        button.textContent = box.classList.contains('hidden') ? 'Показать толкование' : 'Скрыть толкование';
        return;
      }
      button.disabled = true;
      button.textContent = 'Загрузка…';
      try {
        const result = await symbolRequest(`?action=preview&slug=${encodeURIComponent(slug)}`);
        box.textContent = result.article.interpretation;
        box.dataset.loaded = '1';
        box.classList.remove('hidden');
        button.textContent = 'Скрыть толкование';
      } catch (error) {
        box.textContent = error instanceof Error ? error.message : 'Не удалось загрузить толкование.';
        box.classList.remove('hidden');
        button.textContent = 'Повторить';
      } finally { button.disabled = false; }
    }

    async function addSymbolLink() {
      const symbol = symbolText?.value.trim() || '';
      if (!symbol || !selectedSymbolPost || !symbolAdd) return;
      symbolAdd.disabled = true;
      try {
        const response = await fetch(`/api/admin/dream-symbols/${encodeURIComponent(id)}`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'add', symbol_text: symbol, post_slug: selectedSymbolPost.slug }) });
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || 'Не удалось добавить символ.');
        renderSymbolLinks(result.links as SymbolLink[]);
        if (symbolText) symbolText.value = '';
        if (symbolSearch) symbolSearch.value = '';
        selectedSymbolPost = null;
        symbolSelection?.classList.add('hidden');
        showSymbolMessage('Символ и статья подтверждены.', 'success');
      } catch (error) {
        showSymbolMessage(error instanceof Error ? error.message : 'Не удалось добавить символ.', 'error');
      } finally { symbolAdd.disabled = !selectedSymbolPost || !(symbolText?.value.trim()); }
    }

    async function deleteSymbolLink(linkId: string) {
      if (!confirm('Удалить эту связь символа со статьёй?')) return;
      try {
        const response = await fetch(`/api/admin/dream-symbols/${encodeURIComponent(id)}`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'delete', link_id: linkId }) });
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || 'Не удалось удалить связь.');
        renderSymbolLinks(result.links as SymbolLink[]);
        showSymbolMessage('Связь удалена.', 'success');
      } catch (error) { showSymbolMessage(error instanceof Error ? error.message : 'Не удалось удалить связь.', 'error'); }
    }

    async function suggestSymbols() {
      if (!symbolSuggest) return;
      symbolSuggest.disabled = true;
      try {
        const result = await symbolRequest('?action=suggest');
        const suggestions = result.suggestions as Array<{ symbol: string; post: SearchItem }>;
        renderSymbolResults(suggestions.map((item) => item.post), new Map(suggestions.map((item) => [item.post.slug, item.symbol])));
        showSymbolMessage(suggestions.length ? 'Предложения показаны ниже. Выберите статью и подтвердите связь вручную.' : 'Подходящие символы не найдены. Используйте поиск вручную.', 'neutral');
      } catch (error) { showSymbolMessage(error instanceof Error ? error.message : 'Не удалось предложить символы.', 'error'); }
      finally { symbolSuggest.disabled = false; }
    }

    function showSymbolMessage(text: string, kind: 'success' | 'error' | 'neutral') {
      if (!symbolMessage) return;
      symbolMessage.textContent = text;
      symbolMessage.className = kind === 'success' ? 'mt-3 rounded-xl border border-emerald-400/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-200' : kind === 'error' ? 'mt-3 rounded-xl border border-rose-400/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-200' : 'mt-3 rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-slate-300';
    }

    async function saveDreamText() {
      if (!dreamText || !dreamSave) return;
      const value = dreamText.value.trim();
      if (value.length < 20) {
        showDreamMessage('Текст сна должен содержать не менее 20 символов.', 'error');
        return;
      }

      dreamSave.disabled = true;
      showDreamMessage('Сохранение…', 'neutral');
      try {
        const response = await fetch(`/api/admin/dreams/${encodeURIComponent(id)}`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ action: 'update_dream', dream_text: value }),
        });
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || 'Не удалось сохранить текст сна.');
        dreamText.value = result.dream.dream_text;
        updateDreamCount();
        showDreamMessage('Текст сна сохранён', 'success');
      } catch (error) {
        showDreamMessage(error instanceof Error ? error.message : 'Не удалось сохранить текст сна.', 'error');
      } finally {
        dreamSave.disabled = false;
      }
    }

    async function saveSeoIndex() {
      if (!seoIndex || !seoSave) return;
      seoSave.disabled = true;
      if (seoMessage) {
        seoMessage.textContent = 'Сохранение…';
        seoMessage.className = 'mt-4 rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-slate-300';
      }
      try {
        const response = await fetch(`/api/admin/dreams/${encodeURIComponent(id)}`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ action: 'update_seo_index', seo_index: seoIndex.checked }),
        });
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || 'Не удалось сохранить SEO-настройку.');
        if (seoIndex) seoIndex.checked = result.dream.seo_index === 1;
        if (seoMessage) {
          seoMessage.textContent = 'SEO-настройка сохранена.';
          seoMessage.className = 'mt-4 rounded-xl border border-emerald-400/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-200';
        }
      } catch (error) {
        if (seoMessage) {
          seoMessage.textContent = error instanceof Error ? error.message : 'Не удалось сохранить SEO-настройку.';
          seoMessage.className = 'mt-4 rounded-xl border border-rose-400/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-200';
        }
      } finally {
        seoSave.disabled = false;
      }
    }

    function updateStatus(status: Status) {
      const element = document.querySelector<HTMLElement>('[data-status]');
      if (element) {
        element.textContent = status === 'pending' ? 'Новый' : status === 'answered' ? 'Отвечен' : 'Отклонён';
        element.className = status === 'pending'
          ? 'rounded-lg border border-amber-400/30 bg-amber-500/10 px-3 py-1.5 text-sm font-semibold text-amber-200'
          : status === 'answered'
            ? 'rounded-lg border border-emerald-400/30 bg-emerald-500/10 px-3 py-1.5 text-sm font-semibold text-emerald-200'
            : 'rounded-lg border border-rose-400/30 bg-rose-500/10 px-3 py-1.5 text-sm font-semibold text-rose-200';
      }
      const reopen = document.querySelector<HTMLButtonElement>('[data-action="reopen"]');
      reopen?.classList.toggle('hidden', status === 'pending');
    }

    function updateNotificationStatus(dream: DreamRecord) {
      const element = document.querySelector<HTMLElement>('[data-notification-status]');
      if (element) {
        element.textContent = dream.notification_sent_at
          ? `Email отправлен: ${formatDate(dream.notification_sent_at)}`
          : 'Email не отправлен';
        element.className = dream.notification_sent_at
          ? 'mt-1 text-emerald-300'
          : 'mt-1 text-amber-200';
      }

      const resend = document.querySelector<HTMLButtonElement>('[data-action="resend_notification"]');
      if (resend) {
        resend.classList.toggle('hidden', dream.status !== 'answered' || !dream.email.trim());
        resend.textContent = dream.notification_sent_at ? 'Отправить email повторно' : 'Отправить уведомление';
      }
    }

    async function save(action: string) {
      if (!answer) return;
      if (action === 'reject' && !confirm('Отклонить эту запись? Она не будет опубликована.')) return;
      if (action === 'publish' && !confirm('Опубликовать ответ и отметить запись отвеченной?')) return;
      if (action === 'resend_notification' && !confirm('Отправить пользователю email со ссылкой на опубликованный ответ?')) return;
      setBusy(true);
      showMessage('Сохранение…', 'neutral');
      try {
        const response = await fetch(`/api/admin/dreams/${encodeURIComponent(id)}`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ action, answer_text: answer.value }),
        });
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || 'Не удалось сохранить изменения.');
        fillEditor(result.dream as DreamRecord);
        if (result.warning) {
          showMessage(result.warning, 'warning');
        } else {
          showMessage(action === 'draft' ? 'Черновик сохранён.' : action === 'publish' ? 'Ответ опубликован.' : action === 'resend_notification' ? 'Email отправлен.' : action === 'reject' ? 'Запись отклонена.' : 'Запись возвращена в новые.', 'success');
        }
      } catch (error) {
        showMessage(error instanceof Error ? error.message : 'Не удалось сохранить изменения.', 'error');
      } finally {
        setBusy(false);
      }
    }

    async function deleteDream() {
      const warning = currentStatus === 'answered'
        ? 'Удалить этот сон и все связанные с ним данные навсегда? Это действие нельзя отменить.\n\nОпубликованная страница этого сна также перестанет быть доступна.'
        : 'Удалить этот сон и все связанные с ним данные навсегда? Это действие нельзя отменить.';
      if (!confirm(warning)) return;

      setBusy(true);
      if (deleteDreamButton) deleteDreamButton.disabled = true;
      try {
        const response = await fetch(`/api/admin/dreams/${encodeURIComponent(id)}`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ action: 'delete_dream' }),
        });
        const result = await response.json();
        if (!response.ok || !result.ok || !result.deleted) throw new Error(result.error || 'Не удалось удалить запись.');
        window.location.assign('/admin/dreams/?deleted=1');
      } catch (error) {
        if (deleteDreamButton) deleteDreamButton.disabled = false;
        setBusy(false);
        showMessage(error instanceof Error ? error.message : 'Не удалось удалить запись.', 'error');
      }
    }

    function setBusy(busy: boolean) {
      actionButtons.forEach((button) => { button.disabled = busy; });
    }

    function showMessage(text: string, kind: 'success' | 'warning' | 'error' | 'neutral') {
      if (!message) return;
      message.textContent = text;
      message.className = kind === 'success'
        ? 'mt-4 rounded-xl border border-emerald-400/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-200'
        : kind === 'warning'
          ? 'mt-4 rounded-xl border border-amber-400/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-200'
          : kind === 'error'
          ? 'mt-4 rounded-xl border border-rose-400/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-200'
          : 'mt-4 rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-slate-300';
    }

    function showDreamMessage(text: string, kind: 'success' | 'error' | 'neutral') {
      if (!dreamMessage) return;
      dreamMessage.textContent = text;
      dreamMessage.className = kind === 'success'
        ? 'mt-4 rounded-xl border border-emerald-400/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-200'
        : kind === 'error'
          ? 'mt-4 rounded-xl border border-rose-400/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-200'
          : 'mt-4 rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-slate-300';
    }

    function insertText(before: string, after = '') {
      if (!answer) return;
      const start = answer.selectionStart;
      const end = answer.selectionEnd;
      const selected = answer.value.slice(start, end);
      answer.setRangeText(`${before}${selected}${after}`, start, end, 'end');
      answer.focus();
      updateCount();
    }

    document.querySelector('[data-format="bold"]')?.addEventListener('click', () => insertText('**', '**'));
    document.querySelector('[data-format="list"]')?.addEventListener('click', () => insertText('- '));
    document.querySelector('[data-link-toggle]')?.addEventListener('click', async () => {
      linkPanel?.classList.toggle('hidden');
      if (!linkPanel?.classList.contains('hidden')) {
        postSearch?.focus();
        if (!searchIndex) {
          const response = await fetch('/search-index.json');
          searchIndex = response.ok ? await response.json() : [];
        }
        renderPostResults();
      }
    });

    function renderPostResults() {
      if (!postResults || !searchIndex) return;
      postResults.replaceChildren();
      const term = (postSearch?.value || '').trim().toLowerCase();
      if (term.length < 2) {
        const hint = document.createElement('p');
        hint.className = 'text-sm text-slate-400';
        hint.textContent = 'Введите минимум два символа.';
        postResults.append(hint);
        return;
      }
      const matches = searchIndex.filter((item) => item.title.toLowerCase().includes(term) || item.slug.toLowerCase().includes(term) || (item.text || '').toLowerCase().includes(term)).slice(0, 12);
      matches.forEach((item) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'block w-full rounded-lg border border-white/10 bg-white/5 p-3 text-left hover:border-violet-400/40 hover:bg-white/10';
        const title = document.createElement('span');
        title.className = 'block font-semibold text-white';
        title.textContent = item.title;
        const path = document.createElement('span');
        path.className = 'mt-1 block break-all text-xs text-slate-400';
        path.textContent = `/${item.slug}/`;
        button.append(title, path);
        button.addEventListener('click', () => {
          if (!answer) return;
          const start = answer.selectionStart;
          const end = answer.selectionEnd;
          const label = answer.value.slice(start, end) || item.title;
          answer.setRangeText(`[${label}](/${item.slug}/)`, start, end, 'end');
          answer.focus();
          updateCount();
          linkPanel?.classList.add('hidden');
        });
        postResults.append(button);
      });
      if (!matches.length) {
        const empty = document.createElement('p');
        empty.className = 'text-sm text-slate-400';
        empty.textContent = 'Подходящие посты не найдены.';
        postResults.append(empty);
      }
    }

    function setText(selector: string, value: string) {
      const element = document.querySelector<HTMLElement>(selector);
      if (element) element.textContent = value;
    }
    function updateDreamCount() { if (dreamText && dreamCount) dreamCount.textContent = String(dreamText.value.length); }
    function updateCount() { if (answer && count) count.textContent = String(answer.value.length); }
    function formatDate(value: string) {
      const date = new Date(value);
      return Number.isNaN(date.getTime()) ? value : date.toLocaleString('ru-RU', { dateStyle: 'long', timeStyle: 'short' });
    }

    dreamText?.addEventListener('input', updateDreamCount);
    dreamSave?.addEventListener('click', saveDreamText);
    symbolSearch?.addEventListener('input', () => {
      window.clearTimeout(symbolSearchTimer);
      selectedSymbolPost = null;
      symbolSelection?.classList.add('hidden');
      if (symbolAdd) symbolAdd.disabled = true;
      symbolSearchTimer = window.setTimeout(searchSymbols, 250);
    });
    symbolText?.addEventListener('input', () => { if (symbolAdd) symbolAdd.disabled = !selectedSymbolPost || !symbolText.value.trim(); });
    symbolAdd?.addEventListener('click', addSymbolLink);
    symbolSuggest?.addEventListener('click', suggestSymbols);
    seoSave?.addEventListener('click', saveSeoIndex);
    answer?.addEventListener('input', updateCount);
    postSearch?.addEventListener('input', renderPostResults);
    actionButtons.forEach((button) => button.addEventListener('click', () => save(button.dataset.action || '')));
    deleteDreamButton?.addEventListener('click', deleteDream);
    loadDream();
  </script>
</AdminLayout>
