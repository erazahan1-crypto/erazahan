---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Новая HY статья">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div><p class="text-sm font-medium text-violet-300">HY контент</p><h1 class="mt-1 font-display text-3xl font-bold text-white">Новая статья сонника</h1><p class="mt-2 text-sm text-slate-400">Форма локальна, пока вы явно не создадите и не опубликуете статью.</p></div>
    <a href="/admin/posts/" class="inline-flex min-h-11 items-center rounded-xl border border-white/10 px-4 text-sm font-semibold text-slate-200 hover:bg-white/5">К статьям</a>
  </div>
  <form data-form class="mt-7 grid gap-5 rounded-2xl border border-white/10 bg-white/[0.035] p-5" novalidate>
    <label class="grid gap-1.5"><span class="text-sm font-semibold text-slate-200">Title</span><input name="title" required maxlength="200" class="min-h-11 rounded-xl border border-white/10 bg-night-950 px-3 text-white" /></label>
    <label class="grid gap-1.5"><span class="text-sm font-semibold text-slate-200">Slug</span><input name="slug" required maxlength="160" class="min-h-11 rounded-xl border border-white/10 bg-night-950 px-3 text-white" /></label>
    <label class="grid gap-1.5"><span class="text-sm font-semibold text-slate-200">SEO / Meta description</span><textarea name="description" maxlength="2000" rows="3" class="rounded-xl border border-white/10 bg-night-950 px-3 py-2 text-white"></textarea></label>
    <div class="grid gap-5 sm:grid-cols-2"><label class="grid gap-1.5"><span class="text-sm font-semibold text-slate-200">Publication date</span><input name="date" type="date" required class="min-h-11 rounded-xl border border-white/10 bg-night-950 px-3 text-white" /></label><label class="grid gap-1.5"><span class="text-sm font-semibold text-slate-200">Alphabet key</span><input name="letter" maxlength="8" class="min-h-11 rounded-xl border border-white/10 bg-night-950 px-3 text-white" /></label></div>
    <section><span class="text-sm font-semibold text-slate-200">Categories</span><div data-selected class="mt-2 flex flex-wrap gap-2"></div><button data-category-toggle type="button" class="mt-2 min-h-11 rounded-xl border border-white/10 px-3 text-sm font-semibold text-slate-200">Select existing categories</button><div data-category-picker hidden class="mt-2 rounded-xl border border-white/10 bg-night-950 p-3"><input data-category-search type="search" placeholder="Search categories" class="min-h-11 w-full rounded-xl border border-white/10 bg-night-900 px-3 text-white" /><div data-category-results class="mt-2 max-h-52 overflow-y-auto"></div></div></section>
    <label class="grid gap-1.5"><span class="text-sm font-semibold text-slate-200">Content</span><textarea name="content" required rows="16" class="rounded-xl border border-white/10 bg-night-950 px-3 py-2 text-white"></textarea></label>
    <p data-status class="text-sm text-slate-400" role="status">Изображения можно добавить в обычном редакторе после создания.</p>
    <div class="flex flex-wrap gap-3"><button data-submit type="submit" class="min-h-11 rounded-xl bg-violet-600 px-5 text-sm font-semibold text-white hover:bg-violet-500">Создать и опубликовать</button><a href="/admin/posts/" class="inline-flex min-h-11 items-center rounded-xl border border-white/10 px-4 text-sm font-semibold text-slate-200">Отмена</a></div>
  </form>
  <script>
    const form = document.querySelector<HTMLFormElement>('[data-form]')!;
    const status = document.querySelector<HTMLElement>('[data-status]')!;
    const submit = document.querySelector<HTMLButtonElement>('[data-submit]')!;
    form.addEventListener('submit', async (event) => {
      event.preventDefault(); if (!form.reportValidity()) return;
      const data = new FormData(form); const categories = selectedCategories;
      if (!categories.length) { status.textContent = 'At least one category is required.'; return; }
      submit.disabled = true; status.textContent = 'Creating and publishing…';
      try {
        const response = await fetch('/api/admin/posts', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ post: { title: data.get('title'), slug: data.get('slug'), description: data.get('description'), date: data.get('date'), letter: data.get('letter'), categories, content: data.get('content') } }) });
        const result = await response.json() as { ok?: boolean; id?: string; error?: string };
        if (!response.ok || !result.ok || !result.id) throw new Error(result.error || 'Could not create the article.');
        location.assign(`/admin/posts/edit/?id=${encodeURIComponent(result.id)}`);
      } catch (error) { status.className = 'text-sm text-rose-300'; status.textContent = error instanceof Error ? error.message : 'Could not create the article.'; submit.disabled = false; }
    });
    let selectedCategories: string[] = []; let options: { name: string; count: number }[] = [];
    const selected = document.querySelector<HTMLElement>('[data-selected]')!; const picker = document.querySelector<HTMLElement>('[data-category-picker]')!; const search = document.querySelector<HTMLInputElement>('[data-category-search]')!; const results = document.querySelector<HTMLElement>('[data-category-results]')!;
    function renderCategories() { selected.replaceChildren(...selectedCategories.map((name) => { const b = document.createElement('button'); b.type = 'button'; b.textContent = `${name} ×`; b.className = 'rounded-xl border border-violet-400/30 px-3 py-2 text-sm text-violet-100'; b.onclick = () => { selectedCategories = selectedCategories.filter((item) => item !== name); renderCategories(); renderOptions(); }; return b; })); }
    function renderOptions() { const query = search.value.trim().normalize('NFKC').toLocaleLowerCase('hy-AM'); results.replaceChildren(...options.filter((item) => !selectedCategories.includes(item.name) && (!query || item.name.normalize('NFKC').toLocaleLowerCase('hy-AM').includes(query))).map((item) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'block min-h-11 w-full rounded-lg px-2 text-left text-sm text-slate-200 hover:bg-white/5'; b.textContent = `${item.name} (${item.count})`; b.onclick = () => { selectedCategories = [...selectedCategories, item.name]; renderCategories(); renderOptions(); }; return b; })); }
    document.querySelector<HTMLButtonElement>('[data-category-toggle]')!.onclick = async () => { picker.hidden = !picker.hidden; if (!options.length) { const response = await fetch('/admin/posts/categories.json'); options = await response.json(); } renderOptions(); };
    search.oninput = renderOptions;
  </script>
</AdminLayout>
