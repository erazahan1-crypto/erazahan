---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Multilingual post workspace">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div><a href="/admin/posts/" class="text-sm font-semibold text-violet-300 hover:text-violet-200">← Posts</a><h1 class="mt-2 font-display text-3xl font-bold text-white">Multilingual post workspace</h1><p class="mt-2 text-sm text-slate-400">One logical post · HY / RU / EN</p></div>
    <p data-result role="status" class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-slate-300">Loading workspace…</p>
  </div>
  <section data-workspace hidden class="mt-6 grid gap-4 xl:grid-cols-3" aria-label="Three-language post editor"></section>
  <div data-actions hidden class="sticky bottom-4 z-20 mt-6 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-violet-400/30 bg-night-900/95 p-3 shadow-2xl backdrop-blur">
    <p data-summary class="text-sm text-slate-300">HY — unchanged · RU — unchanged · EN — unchanged</p>
    <button data-save type="button" class="min-h-11 rounded-xl bg-violet-600 px-5 text-sm font-bold text-white hover:bg-violet-500 disabled:cursor-not-allowed disabled:opacity-50">Save All</button>
  </div>

  <template id="panel-template"><section class="flex min-h-[46rem] min-w-0 flex-col overflow-hidden rounded-2xl border border-white/10 bg-white/[0.035]"><header class="sticky top-0 z-10 flex items-center justify-between gap-3 border-b border-white/10 bg-night-900/95 px-4 py-3"><div><h2 data-heading class="font-display text-xl font-bold text-white"></h2><p data-lifecycle class="mt-0.5 text-xs text-slate-400"></p></div><span data-dirty class="rounded-full border border-white/10 px-2 py-1 text-xs text-slate-400">Saved</span></header><div class="min-h-0 flex-1 space-y-4 overflow-y-auto p-4"><label class="block"><span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-400">Title</span><input data-field="title" class="min-h-11 w-full rounded-xl border border-white/10 bg-night-950 px-3 text-white outline-none focus:border-violet-400" /></label><label class="block"><span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-400">Slug</span><input data-field="slug" class="min-h-11 w-full rounded-xl border border-white/10 bg-night-950 px-3 text-white outline-none focus:border-violet-400" /></label><label class="block"><span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-400">SEO description</span><textarea data-field="description" rows="3" class="w-full rounded-xl border border-white/10 bg-night-950 p-3 text-white outline-none focus:border-violet-400"></textarea></label><div data-hy-fields class="space-y-4"><label class="block"><span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-400">Date</span><input data-field="date" class="min-h-11 w-full rounded-xl border border-white/10 bg-night-950 px-3 text-white outline-none focus:border-violet-400" /></label><label class="block"><span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-400">Categories (JSON)</span><input data-field="categories" class="min-h-11 w-full rounded-xl border border-white/10 bg-night-950 px-3 text-white outline-none focus:border-violet-400" /></label></div><div data-localized-fields class="space-y-4"><label class="block"><span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-400">Image ALTs (JSON)</span><textarea data-field="image_alts" rows="3" class="w-full rounded-xl border border-white/10 bg-night-950 p-3 font-mono text-xs text-white outline-none focus:border-violet-400"></textarea></label><label class="block"><span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-400">Tags (JSON)</span><input data-field="tags" class="min-h-11 w-full rounded-xl border border-white/10 bg-night-950 px-3 text-white outline-none focus:border-violet-400" /></label><label class="block"><span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-400">Alphabet key</span><input data-field="alphabet_key" class="min-h-11 w-full rounded-xl border border-white/10 bg-night-950 px-3 text-white outline-none focus:border-violet-400" /></label></div><div class="flex flex-wrap gap-2"><button data-link type="button" class="min-h-10 rounded-lg border border-white/10 px-3 text-xs font-semibold hover:bg-white/5">Insert logical link</button><button data-media type="button" class="min-h-10 rounded-lg border border-white/10 px-3 text-xs font-semibold hover:bg-white/5">Insert asset</button></div><label class="block"><span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-400">Body</span><textarea data-field="content" rows="24" class="min-h-[28rem] w-full resize-y rounded-xl border border-white/10 bg-night-950 p-3 font-mono text-sm leading-6 text-white outline-none focus:border-violet-400"></textarea></label><p data-error hidden class="rounded-xl border border-rose-400/30 bg-rose-500/10 p-3 text-sm text-rose-100"></p></div><footer data-locale-actions class="flex flex-wrap gap-2 border-t border-white/10 p-3"><button data-preview type="button" class="min-h-10 rounded-lg border border-white/10 px-3 text-sm font-semibold hover:bg-white/5">Preview</button><button data-publish type="button" class="min-h-10 rounded-lg border border-emerald-400/40 bg-emerald-500/10 px-3 text-sm font-semibold text-emerald-100 hover:bg-emerald-500/20">Publish</button><a data-live target="_blank" rel="noopener" class="hidden min-h-10 items-center rounded-lg border border-white/10 px-3 text-sm font-semibold hover:bg-white/5">Open live</a></footer></section></template>

  <dialog data-link-picker class="m-auto w-[min(42rem,calc(100vw-2rem))] rounded-2xl border border-white/10 bg-night-900 p-0 text-slate-200 shadow-2xl backdrop:bg-black/70"><div class="flex max-h-[calc(100vh-2rem)] flex-col"><div class="flex items-center justify-between border-b border-white/10 p-4"><h2 class="font-display text-xl font-bold text-white">Internal Link</h2><button data-link-close type="button" class="min-h-11 rounded-xl border border-white/10 px-3">Close</button></div><div class="min-h-0 overflow-y-auto p-4"><label class="block text-sm font-semibold">Find HY record<input data-link-search type="search" class="mt-2 min-h-11 w-full rounded-xl border border-white/10 bg-night-950 px-3 text-white" placeholder="Search HY title" /></label><p data-link-status class="mt-3 text-sm text-slate-400" role="status">Search the HY dictionary to choose a logical identity.</p><div data-link-results class="mt-3 divide-y divide-white/10 rounded-xl border border-white/10"></div><label data-link-anchor-wrap hidden class="mt-4 block text-sm font-semibold">Anchor text<input data-link-anchor type="text" class="mt-2 min-h-11 w-full rounded-xl border border-white/10 bg-night-950 px-3 text-white" /></label></div><div class="flex justify-end gap-3 border-t border-white/10 p-4"><button data-link-cancel type="button" class="min-h-11 rounded-xl border border-white/10 px-4">Cancel</button><button data-link-insert type="button" disabled class="min-h-11 rounded-xl bg-violet-600 px-4 font-semibold text-white disabled:opacity-50">Insert</button></div></div></dialog>
  <dialog data-media-picker class="m-auto w-[min(46rem,calc(100vw-2rem))] rounded-2xl border border-white/10 bg-night-900 p-0 text-slate-200 shadow-2xl backdrop:bg-black/70"><div class="flex max-h-[calc(100vh-2rem)] flex-col"><div class="flex items-center justify-between border-b border-white/10 p-4"><h2 class="font-display text-xl font-bold text-white">Insert managed image</h2><button data-media-close type="button" class="min-h-11 rounded-xl border border-white/10 px-3">Close</button></div><div class="min-h-0 overflow-y-auto p-4"><label class="block text-sm font-semibold">Find an asset<input data-media-search type="search" class="mt-2 min-h-11 w-full rounded-xl border border-white/10 bg-night-950 px-3 text-white" placeholder="Search asset ID or type" /></label><p data-media-status class="mt-3 text-sm text-slate-400" role="status">Loading managed images…</p><div data-media-results class="mt-3 grid gap-3 sm:grid-cols-2"></div><div data-media-alt-wrap hidden class="mt-4 rounded-xl border border-white/10 p-3"><p data-media-selected class="break-all text-xs text-slate-400"></p><label class="mt-3 block text-sm font-semibold">Localized ALT<input data-media-alt type="text" maxlength="300" class="mt-2 min-h-11 w-full rounded-xl border border-white/10 bg-night-950 px-3 text-white" /></label><label class="mt-3 flex items-center gap-2 text-sm"><input data-media-decorative type="checkbox" /> Decorative image</label></div></div><div class="flex justify-end gap-3 border-t border-white/10 p-4"><button data-media-cancel type="button" class="min-h-11 rounded-xl border border-white/10 px-4">Cancel</button><button data-media-insert type="button" disabled class="min-h-11 rounded-xl bg-violet-600 px-4 font-semibold text-white disabled:opacity-50">Insert image</button></div></div></dialog>

  <script>
    type Locale = 'hy' | 'ru' | 'en'; type Panel = { locale: Locale; root: HTMLElement; initial: string; state: any; fields: Record<string, HTMLInputElement | HTMLTextAreaElement>; };
    const id = new URL(location.href).searchParams.get('content_id'); const idRe = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;
    const workspace = document.querySelector<HTMLElement>('[data-workspace]')!, actions = document.querySelector<HTMLElement>('[data-actions]')!, result = document.querySelector<HTMLElement>('[data-result]')!, summary = document.querySelector<HTMLElement>('[data-summary]')!, save = document.querySelector<HTMLButtonElement>('[data-save]')!, template = document.querySelector<HTMLTemplateElement>('#panel-template')!;
    const panels = new Map<Locale, Panel>(); let server: any; let saving = false;
    type LinkRow = { content_id: string; title: string; slug: string }; type MediaRow = { asset_id: string; public_url: string; mime_type?: string };
    const linkDialog = document.querySelector<HTMLDialogElement>('[data-link-picker]')!, linkSearch = document.querySelector<HTMLInputElement>('[data-link-search]')!, linkStatus = document.querySelector<HTMLElement>('[data-link-status]')!, linkResults = document.querySelector<HTMLElement>('[data-link-results]')!, linkAnchorWrap = document.querySelector<HTMLElement>('[data-link-anchor-wrap]')!, linkAnchor = document.querySelector<HTMLInputElement>('[data-link-anchor]')!, linkInsert = document.querySelector<HTMLButtonElement>('[data-link-insert]')!;
    const mediaDialog = document.querySelector<HTMLDialogElement>('[data-media-picker]')!, mediaSearch = document.querySelector<HTMLInputElement>('[data-media-search]')!, mediaStatus = document.querySelector<HTMLElement>('[data-media-status]')!, mediaResults = document.querySelector<HTMLElement>('[data-media-results]')!, mediaAltWrap = document.querySelector<HTMLElement>('[data-media-alt-wrap]')!, mediaSelected = document.querySelector<HTMLElement>('[data-media-selected]')!, mediaAlt = document.querySelector<HTMLInputElement>('[data-media-alt]')!, mediaDecorative = document.querySelector<HTMLInputElement>('[data-media-decorative]')!, mediaInsert = document.querySelector<HTMLButtonElement>('[data-media-insert]')!;
    let linkIndex: LinkRow[] | null = null, mediaIndex: MediaRow[] | null = null, pickerPanel: Panel | null = null, pickerSelection = { start: 0, end: 0, text: '' }, selectedLink: LinkRow | null = null, selectedMedia: MediaRow | null = null;
    const localeLabel: Record<Locale, string> = { hy: 'HY · Armenian source', ru: 'RU · Russian', en: 'EN · English' };
    function lifecycle(locale: Locale, data: any) { return locale === 'hy' ? 'Published source' : ({ NOT_CREATED: 'Not created', DRAFT: 'Draft', PUBLISHED: 'Published', PUBLISHED_WITH_DRAFT: 'Published + draft' }[data.translation_state.publication_state] ?? 'Unknown'); }
    function editable(locale: Locale, data: any) { if (locale === 'hy') return structuredClone(data.post); const document = data.locale_document; return structuredClone(document?.draft ?? document?.published ?? { slug: '', title: '', description: null, content: '', image_alts: {}, tags: [], alphabet_key: null }); }
    function normalized(panel: Panel) { const raw: any = {}; for (const [key, field] of Object.entries(panel.fields)) raw[key] = field.value; if (panel.locale === 'hy') { raw.description = raw.description || null; raw.categories = JSON.parse(raw.categories || '[]'); raw.letter = raw.alphabet_key || null; delete raw.alphabet_key; raw.sourceUrl = panel.state.post.sourceUrl; } else { raw.description = raw.description || null; raw.image_alts = JSON.parse(raw.image_alts || '{}'); raw.tags = JSON.parse(raw.tags || '[]'); raw.alphabet_key = raw.alphabet_key || null; } return raw; }
    function dirty(panel: Panel) { try { return JSON.stringify(normalized(panel)) !== panel.initial; } catch { return true; } }
    function refresh() { const labels: string[] = []; for (const panel of panels.values()) { const changed = dirty(panel); panel.root.querySelector<HTMLElement>('[data-dirty]')!.textContent = changed ? 'Changed / Unsaved' : 'Saved'; panel.root.querySelector<HTMLElement>('[data-dirty]')!.className = changed ? 'rounded-full border border-amber-400/40 bg-amber-500/10 px-2 py-1 text-xs text-amber-100' : 'rounded-full border border-white/10 px-2 py-1 text-xs text-slate-400'; labels.push(`${panel.locale.toUpperCase()} — ${changed ? 'changed' : 'unchanged'}`); } summary.textContent = labels.join(' · '); save.disabled = saving || ![...panels.values()].some(dirty); }
    async function getLinks() { if (!linkIndex) { const response = await fetch('/admin/translations/link-index.json', { headers: { accept: 'application/json' } }); const body: unknown = await response.json(); if (!response.ok || !Array.isArray(body)) throw new Error('Unable to load the HY link index.'); linkIndex = body.filter((row): row is LinkRow => !!row && typeof row === 'object' && typeof (row as LinkRow).content_id === 'string' && typeof (row as LinkRow).title === 'string' && typeof (row as LinkRow).slug === 'string'); } return linkIndex; }
    async function renderLinks() { linkResults.replaceChildren(); selectedLink = null; linkInsert.disabled = true; const query = linkSearch.value.trim().toLowerCase(); if (!query) { linkStatus.textContent = 'Enter a HY title or term to search.'; return; } linkStatus.textContent = 'Searching…'; try { const rows = (await getLinks()).filter((row) => row.content_id !== id && `${row.title} ${row.slug}`.toLowerCase().includes(query)).slice(0, 12); if (!rows.length) { linkStatus.textContent = 'No matching HY records found.'; return; } linkStatus.hidden = true; for (const row of rows) { const button = document.createElement('button'); button.type = 'button'; button.className = 'block min-h-11 w-full px-3 py-3 text-left hover:bg-white/5'; button.textContent = `${row.title} — /${row.slug}/`; button.onclick = () => { selectedLink = row; linkInsert.disabled = false; if (!pickerSelection.text) { linkAnchorWrap.hidden = false; linkAnchor.value = row.title; linkAnchor.focus(); } }; linkResults.append(button); } } catch (error) { linkStatus.textContent = error instanceof Error ? error.message : 'Unable to search the HY link index.'; } }
    function openLinkPicker(panel: Panel) { pickerPanel = panel; const field = panel.fields.content; pickerSelection = { start: field.selectionStart, end: field.selectionEnd, text: field.value.slice(field.selectionStart, field.selectionEnd) }; selectedLink = null; linkInsert.disabled = true; linkAnchorWrap.hidden = !!pickerSelection.text; linkAnchor.value = ''; linkSearch.value = pickerSelection.text.trim(); linkStatus.hidden = false; linkDialog.showModal(); linkSearch.focus(); void renderLinks(); }
    function insertLink() { if (!pickerPanel || !selectedLink) return; const anchor = pickerSelection.text || linkAnchor.value; if (!anchor.trim()) { linkAnchor.focus(); return; } const field = pickerPanel.fields.content; field.setRangeText(`[${anchor.replace(/\\/g, '\\\\').replace(/\[/g, '\\[').replace(/\]/g, '\\]')}](content://${selectedLink.content_id})`, pickerSelection.start, pickerSelection.end, 'end'); linkDialog.close(); refresh(); field.focus(); }
    async function getMedia() { if (!mediaIndex) { const response = await fetch('/admin/translations/media-index.json', { headers: { accept: 'application/json' } }); const body: unknown = await response.json(); if (!response.ok || !Array.isArray(body)) throw new Error('Unable to load managed images.'); mediaIndex = body.filter((row): row is MediaRow => !!row && typeof row === 'object' && typeof (row as MediaRow).asset_id === 'string' && typeof (row as MediaRow).public_url === 'string'); } return mediaIndex; }
    function updateMediaInsert() { mediaInsert.disabled = !selectedMedia || (!mediaDecorative.checked && !mediaAlt.value.trim()); }
    async function renderMedia() { mediaResults.replaceChildren(); const query = mediaSearch.value.trim().toLowerCase(); try { const rows = (await getMedia()).filter((row) => !query || `${row.asset_id} ${row.mime_type ?? ''}`.toLowerCase().includes(query)); mediaStatus.textContent = rows.length ? `${rows.length} managed image${rows.length === 1 ? '' : 's'} available.` : 'No managed images match that search.'; for (const row of rows.slice(0, 100)) { const button = document.createElement('button'); button.type = 'button'; button.className = 'overflow-hidden rounded-xl border border-white/10 bg-night-950 text-left hover:border-violet-400'; const image = document.createElement('img'); image.src = row.public_url; image.alt = ''; image.loading = 'lazy'; image.className = 'h-28 w-full object-contain'; const label = document.createElement('code'); label.className = 'block break-all p-2 text-xs'; label.textContent = row.asset_id; button.append(image, label); button.onclick = () => { selectedMedia = row; mediaAltWrap.hidden = false; mediaSelected.textContent = row.asset_id; try { const alts = JSON.parse(pickerPanel!.fields.image_alts.value || '{}'); mediaDecorative.checked = alts[row.asset_id] === ''; mediaAlt.value = alts[row.asset_id] ?? ''; } catch { mediaDecorative.checked = false; mediaAlt.value = ''; } mediaAlt.disabled = mediaDecorative.checked; updateMediaInsert(); }; mediaResults.append(button); } } catch (error) { mediaStatus.textContent = error instanceof Error ? error.message : 'Unable to load managed images.'; } }
    function openMediaPicker(panel: Panel) { if (panel.locale === 'hy') return; pickerPanel = panel; const field = panel.fields.content; pickerSelection = { start: field.selectionStart, end: field.selectionEnd, text: '' }; selectedMedia = null; mediaAltWrap.hidden = true; mediaInsert.disabled = true; mediaSearch.value = ''; mediaDialog.showModal(); mediaSearch.focus(); void renderMedia(); }
    function insertMedia() { if (!pickerPanel || !selectedMedia) return; let alts: Record<string, string>; try { alts = JSON.parse(pickerPanel.fields.image_alts.value || '{}'); if (!alts || typeof alts !== 'object' || Array.isArray(alts)) throw new Error(); } catch { showError(pickerPanel, 'Image ALTs must be a JSON object of strings before inserting an image.'); return; } if (!mediaDecorative.checked && !mediaAlt.value.trim()) { mediaAlt.focus(); return; } alts[selectedMedia.asset_id] = mediaDecorative.checked ? '' : mediaAlt.value.trim(); pickerPanel.fields.image_alts.value = JSON.stringify(alts, null, 2); const field = pickerPanel.fields.content; field.setRangeText(`![](asset://${selectedMedia.asset_id})`, pickerSelection.start, pickerSelection.end, 'end'); mediaDialog.close(); refresh(); field.focus(); }
    function addPanel(locale: Locale, data: any) { const root = template.content.firstElementChild!.cloneNode(true) as HTMLElement; const values = editable(locale, data); root.querySelector<HTMLElement>('[data-heading]')!.textContent = localeLabel[locale]; root.querySelector<HTMLElement>('[data-lifecycle]')!.textContent = lifecycle(locale, data); if (locale === 'hy') { root.querySelector<HTMLElement>('[data-localized-fields]')!.hidden = true; root.querySelector<HTMLElement>('[data-locale-actions]')!.hidden = true; root.querySelector<HTMLButtonElement>('[data-media]')!.hidden = true; } else root.querySelector<HTMLElement>('[data-hy-fields]')!.hidden = true;
      const fields: Record<string, HTMLInputElement | HTMLTextAreaElement> = {}; root.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-field]').forEach((field) => { fields[field.dataset.field!] = field; const value = field.dataset.field === 'categories' ? JSON.stringify(values.categories ?? []) : field.dataset.field === 'image_alts' ? JSON.stringify(values.image_alts ?? {}, null, 2) : field.dataset.field === 'tags' ? JSON.stringify(values.tags ?? []) : field.dataset.field === 'alphabet_key' && locale === 'hy' ? values.letter ?? '' : values[field.dataset.field!] ?? ''; field.value = typeof value === 'string' ? value : String(value); field.addEventListener('input', refresh); });
      const panel: Panel = { locale, root, state: data, fields, initial: '' }; panel.initial = JSON.stringify(normalized(panel)); panels.set(locale, panel); root.querySelector<HTMLButtonElement>('[data-link]')!.onclick = () => openLinkPicker(panel); root.querySelector<HTMLButtonElement>('[data-media]')!.onclick = () => openMediaPicker(panel);
      if (locale !== 'hy') { const doc = data.locale_document; const published = doc?.published; const live = root.querySelector<HTMLAnchorElement>('[data-live]')!; if (published) { live.href = `/${locale}/${encodeURIComponent(published.slug)}/`; live.classList.remove('hidden'); live.classList.add('inline-flex'); } const publish = root.querySelector<HTMLButtonElement>('[data-publish]')!; publish.disabled = !doc?.draft; publish.onclick = () => publishLocale(panel); root.querySelector<HTMLButtonElement>('[data-preview]')!.onclick = () => preview(panel); }
      workspace.append(root);
    }
    function showError(panel: Panel, message: string) { const error = panel.root.querySelector<HTMLElement>('[data-error]')!; error.textContent = message; error.hidden = false; }
    async function load() { if (!id || !idRe.test(id)) { result.textContent = 'A valid content ID is required.'; return; } const response = await fetch(`/api/admin/workspace/${id}`, { headers: { accept: 'application/json' } }); const body = await response.json(); if (!response.ok || !body?.ok) throw new Error(body?.message || 'Workspace is unavailable.'); server = body; workspace.replaceChildren(); panels.clear(); addPanel('hy', body.hy); addPanel('ru', body.ru); addPanel('en', body.en); workspace.hidden = false; actions.hidden = false; result.textContent = `Workspace loaded for ${id}`; refresh(); }
    async function saveAll() { if (saving || !server) return; const changed: any = {}; try { for (const [locale, panel] of panels) if (dirty(panel)) { if (locale === 'hy') changed.hy = { expectedPostsBlobSha: server.hy.posts_blob_sha, originalSlug: panel.state.post.slug, post: normalized(panel) }; else changed[locale] = panel.state.locale_document ? { expectedLocaleBlobSha: panel.state.locale_blob_sha, payload: normalized(panel) } : { expectedLocaleAbsent: true, payload: normalized(panel) }; } } catch { result.textContent = 'Correct JSON fields before saving.'; return; } if (!Object.keys(changed).length) { result.textContent = 'No changes to save.'; return; } saving = true; refresh(); result.textContent = 'Saving all changed languages as one transaction…'; try { const response = await fetch(`/api/admin/workspace/${id}`, { method: 'POST', headers: { 'content-type': 'application/json', accept: 'application/json' }, body: JSON.stringify({ changed }) }); const body = await response.json(); if (!response.ok || !body?.ok) throw new Error(body?.message || 'Save failed.'); if (body.code === 'NO_CHANGES') result.textContent = 'No changes to save.'; else { server = { ok: true, ...body.state }; workspace.replaceChildren(); panels.clear(); addPanel('hy', server.hy); addPanel('ru', server.ru); addPanel('en', server.en); result.textContent = `Saved: ${Object.entries(body.saved).filter(([, value]) => value).map(([key]) => key.toUpperCase()).join(', ') || 'no changes'}.`; } } catch (error) { result.textContent = error instanceof Error ? error.message : 'Save failed.'; } finally { saving = false; refresh(); } }
    async function publishLocale(panel: Panel) { if (!id || !panel.state.locale_blob_sha || dirty(panel)) { showError(panel, 'Save this panel first, then publish its saved draft.'); return; } const response = await fetch('/api/admin/translations', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'publish', content_id: id, locale: panel.locale, expected_locale_blob_sha: panel.state.locale_blob_sha }) }); const body = await response.json(); if (!response.ok || !body?.ok) { showError(panel, body?.message || 'Publish failed.'); return; } await load(); result.textContent = `${panel.locale.toUpperCase()} published. Other languages were not published.`; }
    function preview(panel: Panel) { try { const form = document.createElement('form'); form.method = 'POST'; form.action = '/api/admin/workspace/preview'; form.target = '_blank'; const add = (name: string, value: string) => { const input = document.createElement('input'); input.type = 'hidden'; input.name = name; input.value = value; form.append(input); }; add('content_id', id!); add('locale', panel.locale); add('payload', JSON.stringify(normalized(panel))); document.body.append(form); form.submit(); form.remove(); } catch { showError(panel, 'Correct JSON fields before previewing.'); } }
    document.querySelector<HTMLButtonElement>('[data-link-close]')!.onclick = () => linkDialog.close(); document.querySelector<HTMLButtonElement>('[data-link-cancel]')!.onclick = () => linkDialog.close(); linkSearch.addEventListener('input', () => { linkStatus.hidden = false; void renderLinks(); }); linkInsert.onclick = insertLink;
    document.querySelector<HTMLButtonElement>('[data-media-close]')!.onclick = () => mediaDialog.close(); document.querySelector<HTMLButtonElement>('[data-media-cancel]')!.onclick = () => mediaDialog.close(); mediaSearch.addEventListener('input', () => { void renderMedia(); }); mediaAlt.addEventListener('input', updateMediaInsert); mediaDecorative.addEventListener('change', () => { mediaAlt.disabled = mediaDecorative.checked; if (mediaDecorative.checked) mediaAlt.value = ''; updateMediaInsert(); }); mediaInsert.onclick = insertMedia;
    save.onclick = saveAll; addEventListener('beforeunload', (event) => { if ([...panels.values()].some(dirty)) { event.preventDefault(); event.returnValue = ''; } }); load().catch((error) => { result.textContent = error instanceof Error ? error.message : 'Workspace is unavailable.'; });
  </script>
</AdminLayout>
