---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Translation Editor — Admin">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-sm font-medium text-violet-300">Read-only translation state</p>
      <h1 class="mt-1 font-display text-3xl font-bold text-white">Translation Editor</h1>
      <p class="mt-2 text-sm text-slate-400">Locale content and HY source are displayed without editing controls.</p>
    </div>
    <div class="flex gap-2" aria-label="Translation locale">
      <a data-locale-link="ru" class="inline-flex min-h-11 items-center rounded-xl border border-white/10 px-4 text-sm font-semibold text-slate-200 hover:bg-white/5">RU</a>
      <a data-locale-link="en" class="inline-flex min-h-11 items-center rounded-xl border border-white/10 px-4 text-sm font-semibold text-slate-200 hover:bg-white/5">EN</a>
    </div>
  </div>

  <p data-status class="mt-6 rounded-xl border border-white/10 bg-white/5 p-4 text-sm text-slate-300" role="status">Loading translation data…</p>

  <div data-editor hidden class="mt-6 space-y-6">
    <section class="rounded-2xl border border-white/10 bg-white/[0.035] p-4">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 class="font-display text-xl font-bold text-white">Locale state</h2>
          <p data-publication-label class="mt-1 text-sm text-slate-300"></p>
        </div>
        <code data-publication-state class="rounded-lg bg-white/5 px-3 py-1.5 text-xs text-slate-300"></code>
      </div>
      <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
        <div><dt class="text-slate-400">Current locale</dt><dd data-current-locale class="mt-1 font-semibold text-white"></dd></div>
        <div><dt class="text-slate-400">Content ID</dt><dd data-content-id class="mt-1 break-all font-mono text-xs text-slate-300"></dd></div>
        <div><dt class="text-slate-400">Slug</dt><dd data-slug-lock class="mt-1 text-slate-200"></dd></div>
        <div><dt class="text-slate-400">Alphabet</dt><dd data-alphabet-suggestion class="mt-1 text-slate-200"></dd></div>
      </dl>
    </section>

    <section class="rounded-2xl border border-white/10 bg-white/[0.035] p-4">
      <h2 class="font-display text-xl font-bold text-white">Synchronization</h2>
      <p data-outdated-warning hidden class="mt-3 rounded-xl border border-amber-400/30 bg-amber-500/10 p-3 text-sm text-amber-200">HY source has changed. This screen does not make any automatic changes.</p>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <div class="rounded-xl border border-white/10 bg-night-950 p-3"><p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Draft</p><code data-draft-sync class="mt-2 block text-sm text-slate-200"></code></div>
        <div class="rounded-xl border border-white/10 bg-night-950 p-3"><p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Published</p><code data-published-sync class="mt-2 block text-sm text-slate-200"></code></div>
      </div>
    </section>

    <section class="rounded-2xl border border-white/10 bg-white/[0.035] p-4">
      <div class="flex flex-wrap items-center justify-between gap-3"><h2 class="font-display text-xl font-bold text-white">HY source</h2><span class="text-xs text-slate-400">Read only</span></div>
      <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
        <div><dt class="text-slate-400">Revision</dt><dd data-source-revision class="mt-1 text-slate-200"></dd></div>
        <div><dt class="text-slate-400">Fingerprint</dt><dd data-source-fingerprint class="mt-1 break-all font-mono text-xs text-slate-300"></dd></div>
      </dl>
      <div data-source-fields class="mt-5"></div>
    </section>

    <section class="rounded-2xl border border-white/10 bg-white/[0.035] p-4">
      <h2 class="font-display text-xl font-bold text-white">Translation document</h2>
      <p data-no-document class="mt-3 text-sm text-slate-400">No RU/EN translation document created yet.</p>
      <div class="mt-5"><button data-begin-edit-action type="button" hidden class="min-h-11 rounded-xl bg-violet-600 px-4 text-sm font-semibold text-white disabled:cursor-not-allowed disabled:opacity-60">Begin Edit</button></div>
      <p data-write-error hidden class="mt-4 rounded-xl border border-rose-400/30 bg-rose-500/10 p-3 text-sm text-rose-200" role="alert"></p>
      <form data-draft-form hidden class="mt-5 space-y-4" novalidate>
        <div class="flex flex-wrap items-center justify-between gap-3"><div><h3 class="font-display text-lg font-bold text-white">Local draft</h3><p class="mt-1 text-xs text-slate-400">Changes stay in this browser until server save is enabled.</p></div><p data-dirty hidden class="rounded-lg border border-amber-400/30 bg-amber-500/10 px-3 py-1.5 text-xs font-semibold text-amber-200">Unsaved changes</p></div>
        <label class="block"><span class="mb-1 block text-sm font-semibold text-white">Slug</span><input data-draft-field="slug" class="min-h-11 w-full rounded-xl border border-white/10 bg-night-950 px-3 text-white" /></label>
        <label class="block"><span class="mb-1 block text-sm font-semibold text-white">Title</span><input data-draft-field="title" class="min-h-11 w-full rounded-xl border border-white/10 bg-night-950 px-3 text-white" /></label>
        <label class="block"><span class="mb-1 block text-sm font-semibold text-white">Description</span><textarea data-draft-field="description" rows="3" class="w-full rounded-xl border border-white/10 bg-night-950 p-3 text-white"></textarea></label>
        <div>
          <div class="mb-1 flex flex-wrap items-center justify-between gap-2"><span class="block text-sm font-semibold text-white">Content</span><div class="flex flex-wrap gap-2"><button data-internal-link-action type="button" class="min-h-11 rounded-xl border border-white/10 px-3 text-sm font-semibold text-slate-200 hover:bg-white/5">Internal Link</button><button data-insert-image-action type="button" class="min-h-11 rounded-xl border border-white/10 px-3 text-sm font-semibold text-slate-200 hover:bg-white/5">Insert Image</button></div></div>
          <textarea data-draft-field="content" rows="12" class="w-full rounded-xl border border-white/10 bg-night-950 p-3 font-mono text-white"></textarea>
        </div>
        <details class="rounded-xl border border-white/10 bg-night-950/40 p-3"><summary class="cursor-pointer text-sm font-semibold text-slate-200">Advanced: Image alts JSON</summary><label class="mt-3 block"><span class="mb-1 block text-sm font-semibold text-white">Image alts (JSON object)</span><textarea data-draft-field="image_alts" rows="4" class="w-full rounded-xl border border-white/10 bg-night-950 p-3 font-mono text-white"></textarea></label></details>
        <label class="block"><span class="mb-1 block text-sm font-semibold text-white">Tags (JSON string array)</span><textarea data-draft-field="tags" rows="3" class="w-full rounded-xl border border-white/10 bg-night-950 p-3 font-mono text-white"></textarea></label>
        <label class="block"><span class="mb-1 block text-sm font-semibold text-white">Alphabet key</span><input data-draft-field="alphabet_key" class="min-h-11 w-full rounded-xl border border-white/10 bg-night-950 px-3 text-white" /></label>
        <button data-use-alphabet type="button" hidden class="min-h-11 rounded-xl border border-white/10 px-4 text-sm font-semibold text-slate-200 hover:bg-white/5">Use suggestion</button>
        <p data-form-error hidden class="rounded-xl border border-rose-400/30 bg-rose-500/10 p-3 text-sm text-rose-200"></p>
        <div class="flex flex-wrap items-center gap-3"><button data-draft-action type="button" disabled class="min-h-11 rounded-xl bg-violet-600 px-4 text-sm font-semibold text-white disabled:cursor-not-allowed disabled:opacity-60" aria-describedby="draft-save-help"></button><button data-publish-action type="button" hidden disabled class="min-h-11 rounded-xl border border-white/10 px-4 text-sm font-semibold text-slate-200 hover:bg-white/5 disabled:cursor-not-allowed disabled:opacity-60" aria-describedby="publish-help">Publish</button><button data-rebase-action type="button" hidden disabled class="min-h-11 rounded-xl border border-amber-400/40 px-4 text-sm font-semibold text-amber-100 hover:bg-amber-500/10 disabled:cursor-not-allowed disabled:opacity-60" aria-describedby="rebase-help rebase-dirty-help">Mark reviewed for current HY</button><button data-discard-action type="button" hidden disabled class="min-h-11 rounded-xl border border-rose-400/40 px-4 text-sm font-semibold text-rose-200 hover:bg-rose-500/10 disabled:cursor-not-allowed disabled:opacity-60">Discard Draft</button><p id="draft-save-help" class="text-xs text-slate-400">Changes are saved to the server.</p><p id="publish-help" hidden class="text-xs text-slate-400">Save local changes before publishing the saved server draft.</p><p id="rebase-help" hidden class="text-xs text-slate-400">Translation text will not change.</p><p id="rebase-dirty-help" hidden class="text-xs text-amber-200">Save your draft changes before marking it reviewed.</p></div>
      </form>
      <div data-locale-snapshots class="mt-5 space-y-5"></div>
    </section>

    <dialog data-internal-link-dialog class="m-auto w-[min(42rem,calc(100vw-2rem))] max-w-none overflow-hidden rounded-2xl border border-white/10 bg-night-900 p-0 text-slate-200 shadow-2xl backdrop:bg-black/70">
      <div class="flex max-h-[min(44rem,calc(100vh-2rem))] flex-col">
        <div class="flex items-center justify-between gap-3 border-b border-white/10 px-4 py-3 sm:px-5"><h2 class="font-display text-xl font-bold text-white">Internal Link</h2><button data-internal-link-close type="button" aria-label="Close" class="grid min-h-11 min-w-11 place-items-center rounded-xl border border-white/10 text-xl hover:bg-white/5">×</button></div>
        <section class="min-h-0 overflow-y-auto p-4 sm:p-5">
          <label class="block"><span class="mb-1.5 block text-sm font-semibold text-white">Find HY record</span><input data-internal-link-search type="search" autocomplete="off" placeholder="Search HY title" class="min-h-11 w-full rounded-xl border border-white/10 bg-night-950 px-3 text-white outline-none placeholder:text-slate-500 focus:border-violet-400" /></label>
          <p data-internal-link-status class="mt-3 text-sm text-slate-400" role="status">Search the HY dictionary to select a logical content identity.</p>
          <div data-internal-link-results class="mt-3 divide-y divide-white/10 overflow-hidden rounded-xl border border-white/10"></div>
          <label data-internal-link-anchor-wrap hidden class="mt-4 block"><span class="mb-1.5 block text-sm font-semibold text-white">Anchor text</span><input data-internal-link-anchor type="text" class="min-h-11 w-full rounded-xl border border-white/10 bg-night-950 px-3 text-white outline-none focus:border-violet-400" /><span data-internal-link-anchor-error hidden class="mt-2 block text-xs text-rose-300">Enter anchor text before inserting.</span></label>
        </section>
        <div class="flex flex-wrap justify-end gap-3 border-t border-white/10 px-4 py-3 sm:px-5"><button data-internal-link-cancel type="button" class="min-h-11 rounded-xl border border-white/10 px-4 text-sm font-semibold text-slate-200 hover:bg-white/5">Cancel</button><button data-internal-link-insert type="button" disabled class="min-h-11 rounded-xl bg-violet-600 px-4 text-sm font-semibold text-white disabled:cursor-not-allowed disabled:opacity-60">Insert</button></div>
      </div>
    </dialog>

    <dialog data-managed-image-dialog class="m-auto w-[min(46rem,calc(100vw-2rem))] max-w-none overflow-hidden rounded-2xl border border-white/10 bg-night-900 p-0 text-slate-200 shadow-2xl backdrop:bg-black/70">
      <div class="flex max-h-[min(48rem,calc(100vh-2rem))] flex-col">
        <div class="flex items-center justify-between gap-3 border-b border-white/10 px-4 py-3 sm:px-5"><div><h2 class="font-display text-xl font-bold text-white">Insert managed image</h2><p class="mt-1 text-xs text-slate-400">Images use immutable asset IDs; public URLs are preview-only.</p></div><button data-managed-image-close type="button" aria-label="Close" class="grid min-h-11 min-w-11 place-items-center rounded-xl border border-white/10 text-xl hover:bg-white/5">×</button></div>
        <section class="min-h-0 overflow-y-auto p-4 sm:p-5">
          <label class="block"><span class="mb-1.5 block text-sm font-semibold text-white">Find an asset</span><input data-managed-image-search type="search" autocomplete="off" placeholder="Search asset ID or type" class="min-h-11 w-full rounded-xl border border-white/10 bg-night-950 px-3 text-white outline-none placeholder:text-slate-500 focus:border-violet-400" /></label>
          <p data-managed-image-status class="mt-3 text-sm text-slate-400" role="status">Loading managed images…</p>
          <div data-managed-image-results class="mt-3 grid gap-3 sm:grid-cols-2"></div>
          <div data-managed-image-alt-wrap hidden class="mt-5 rounded-xl border border-white/10 bg-night-950 p-4"><p data-managed-image-selected class="break-all text-xs text-slate-400"></p><label class="mt-3 block"><span class="mb-1.5 block text-sm font-semibold text-white">Localized ALT</span><input data-managed-image-alt type="text" maxlength="300" class="min-h-11 w-full rounded-xl border border-white/10 bg-night-900 px-3 text-white outline-none focus:border-violet-400" /></label><label class="mt-3 flex items-center gap-2 text-sm text-slate-200"><input data-managed-image-decorative type="checkbox" class="h-4 w-4" /> Decorative image</label><p class="mt-3 text-xs text-slate-400">Reusing an asset updates its localized ALT for every occurrence in this localized document.</p><p data-managed-image-error hidden class="mt-3 rounded-xl border border-rose-400/30 bg-rose-500/10 p-3 text-sm text-rose-200" role="alert"></p></div>
        </section>
        <div class="flex flex-wrap justify-end gap-3 border-t border-white/10 px-4 py-3 sm:px-5"><button data-managed-image-cancel type="button" class="min-h-11 rounded-xl border border-white/10 px-4 text-sm font-semibold text-slate-200 hover:bg-white/5">Cancel</button><button data-managed-image-insert type="button" disabled class="min-h-11 rounded-xl bg-violet-600 px-4 text-sm font-semibold text-white disabled:cursor-not-allowed disabled:opacity-60">Insert Image</button></div>
      </div>
    </dialog>

    <details class="rounded-2xl border border-white/10 bg-white/[0.035] p-4">
      <summary class="cursor-pointer text-sm font-semibold text-slate-200">Technical metadata</summary>
      <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-2"><div><dt class="text-slate-400">Locale blob SHA</dt><dd data-locale-blob-sha class="mt-1 break-all font-mono text-xs text-slate-300"></dd></div><div><dt class="text-slate-400">Backend state</dt><dd data-derived-state class="mt-1 font-mono text-xs text-slate-300"></dd></div></dl>
    </details>
  </div>

  <script>
    // @ts-ignore Shared client-side ranking helper.
    import { prepareSearchIndex, rankPreparedSearch } from '../../../lib/public-search.mjs';
    type Locale = 'ru' | 'en';
    type SyncState = 'CURRENT' | 'OUTDATED' | 'NOT_CREATED';
    type PublicationState = 'NOT_CREATED' | 'DRAFT' | 'PUBLISHED' | 'PUBLISHED_WITH_DRAFT';
    type Payload = { slug: string; title: string; description: string | null; content: string; image_alts: Record<string, string>; tags: string[]; alphabet_key: string | null; version?: number; published_at?: string };
    type TranslationResponse = {
      ok: true; content_id: string; locale: Locale;
      source: { revision: number; fingerprint: string; title: string; description: string | null; content: string; image_alts: Record<string, string>; tags: string[]; alphabet_key: string | null };
      locale_document: { draft: Payload | null; published: Payload | null } | null;
      locale_blob_sha: string | null;
      translation_state: { state: string; publication_state: PublicationState; draft_synchronization: SyncState; published_synchronization: SyncState };
      slug_locked: boolean; alphabet_suggestion: string | null;
    };

    const CONTENT_ID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[57][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
    const params = new URLSearchParams(location.search);
    const contentId = params.get('content_id');
    const locale = params.get('locale');
    const status = document.querySelector<HTMLElement>('[data-status]')!;
    const editor = document.querySelector<HTMLElement>('[data-editor]')!;
    const draftForm = document.querySelector<HTMLFormElement>('[data-draft-form]')!;
    const dirtyIndicator = document.querySelector<HTMLElement>('[data-dirty]')!;
    const formError = document.querySelector<HTMLElement>('[data-form-error]')!;
    const draftAction = document.querySelector<HTMLButtonElement>('[data-draft-action]')!;
    const publishAction = document.querySelector<HTMLButtonElement>('[data-publish-action]')!;
    const rebaseAction = document.querySelector<HTMLButtonElement>('[data-rebase-action]')!;
    const discardAction = document.querySelector<HTMLButtonElement>('[data-discard-action]')!;
    const beginEditAction = document.querySelector<HTMLButtonElement>('[data-begin-edit-action]')!;
    const publishHelp = document.querySelector<HTMLElement>('#publish-help')!;
    const rebaseHelp = document.querySelector<HTMLElement>('#rebase-help')!;
    const rebaseDirtyHelp = document.querySelector<HTMLElement>('#rebase-dirty-help')!;
    const useAlphabet = document.querySelector<HTMLButtonElement>('[data-use-alphabet]')!;
    const contentField = document.querySelector<HTMLTextAreaElement>('[data-draft-field="content"]')!;
    const internalLinkAction = document.querySelector<HTMLButtonElement>('[data-internal-link-action]')!;
    const internalLinkDialog = document.querySelector<HTMLDialogElement>('[data-internal-link-dialog]')!;
    const internalLinkClose = document.querySelector<HTMLButtonElement>('[data-internal-link-close]')!;
    const internalLinkCancel = document.querySelector<HTMLButtonElement>('[data-internal-link-cancel]')!;
    const internalLinkSearch = document.querySelector<HTMLInputElement>('[data-internal-link-search]')!;
    const internalLinkStatus = document.querySelector<HTMLElement>('[data-internal-link-status]')!;
    const internalLinkResults = document.querySelector<HTMLElement>('[data-internal-link-results]')!;
    const internalLinkAnchorWrap = document.querySelector<HTMLElement>('[data-internal-link-anchor-wrap]')!;
    const internalLinkAnchor = document.querySelector<HTMLInputElement>('[data-internal-link-anchor]')!;
    const internalLinkAnchorError = document.querySelector<HTMLElement>('[data-internal-link-anchor-error]')!;
    const internalLinkInsert = document.querySelector<HTMLButtonElement>('[data-internal-link-insert]')!;
    const insertImageAction = document.querySelector<HTMLButtonElement>('[data-insert-image-action]')!;
    const managedImageDialog = document.querySelector<HTMLDialogElement>('[data-managed-image-dialog]')!;
    const managedImageClose = document.querySelector<HTMLButtonElement>('[data-managed-image-close]')!;
    const managedImageCancel = document.querySelector<HTMLButtonElement>('[data-managed-image-cancel]')!;
    const managedImageSearch = document.querySelector<HTMLInputElement>('[data-managed-image-search]')!;
    const managedImageStatus = document.querySelector<HTMLElement>('[data-managed-image-status]')!;
    const managedImageResults = document.querySelector<HTMLElement>('[data-managed-image-results]')!;
    const managedImageAltWrap = document.querySelector<HTMLElement>('[data-managed-image-alt-wrap]')!;
    const managedImageSelected = document.querySelector<HTMLElement>('[data-managed-image-selected]')!;
    const managedImageAlt = document.querySelector<HTMLInputElement>('[data-managed-image-alt]')!;
    const managedImageDecorative = document.querySelector<HTMLInputElement>('[data-managed-image-decorative]')!;
    const managedImageError = document.querySelector<HTMLElement>('[data-managed-image-error]')!;
    const managedImageInsert = document.querySelector<HTMLButtonElement>('[data-managed-image-insert]')!;
    const writeError = document.querySelector<HTMLElement>('[data-write-error]')!;
    type EditablePayload = Omit<Payload, 'version' | 'published_at'>;
    let draftBuffer: EditablePayload | null = null;
    let draftBaseline = '';
    let loadedState: TranslationResponse | null = null;
    let localeBlobSha: string | null = null;
    let saving = false;
    let writeBlocked = false;
    type TranslationLinkRecord = { content_id: string; title: string; slug: string };
    let translationLinkIndex: TranslationLinkRecord[] | null = null;
    let preparedTranslationLinkIndex: ReturnType<typeof prepareSearchIndex> | null = null;
    let translationLinkIndexRequest: Promise<TranslationLinkRecord[]> | null = null;
    let internalLinkSearchTimer = 0;
    let internalLinkSession = 0;
    let savedContentSelection = { start: 0, end: 0, text: '' };
    let selectedLinkTarget: TranslationLinkRecord | null = null;
    type TranslationMediaRecord = { asset_id: string; public_url: string; mime_type?: string; width?: number; height?: number };
    let translationMediaIndex: TranslationMediaRecord[] | null = null;
    let translationMediaIndexRequest: Promise<TranslationMediaRecord[]> | null = null;
    let managedImageSession = 0;
    let savedImageSelection = { start: 0, end: 0 };
    let selectedManagedImage: TranslationMediaRecord | null = null;

    function showStatus(message: string, tone: 'neutral' | 'error' = 'neutral') {
      status.hidden = false;
      status.textContent = message;
      status.className = `mt-6 rounded-xl border p-4 text-sm ${tone === 'error' ? 'border-rose-400/30 bg-rose-400/10 text-rose-200' : 'border-white/10 bg-white/5 text-slate-300'}`;
    }
    function text(selector: string, value: string) { document.querySelector<HTMLElement>(selector)!.textContent = value; }
    function validLocale(value: string | null): value is Locale { return value === 'ru' || value === 'en'; }
    function validSync(value: unknown): value is SyncState { return value === 'CURRENT' || value === 'OUTDATED' || value === 'NOT_CREATED'; }
    function validPublication(value: unknown): value is PublicationState { return value === 'NOT_CREATED' || value === 'DRAFT' || value === 'PUBLISHED' || value === 'PUBLISHED_WITH_DRAFT'; }
    function stringMap(value: unknown): value is Record<string, string> { return !!value && typeof value === 'object' && !Array.isArray(value) && Object.values(value).every((entry) => typeof entry === 'string'); }
    function validPayload(value: unknown, published = false): value is Payload {
      if (!value || typeof value !== 'object' || Array.isArray(value)) return false;
      const payload = value as Partial<Payload>;
      return typeof payload.slug === 'string' && typeof payload.title === 'string' && (typeof payload.description === 'string' || payload.description === null)
        && typeof payload.content === 'string' && stringMap(payload.image_alts) && Array.isArray(payload.tags) && payload.tags.every((tag) => typeof tag === 'string')
        && (typeof payload.alphabet_key === 'string' || payload.alphabet_key === null)
        && (!published || (Number.isInteger(payload.version) && typeof payload.published_at === 'string'));
    }
    function validSource(value: unknown): value is TranslationResponse['source'] {
      if (!value || typeof value !== 'object' || Array.isArray(value)) return false;
      const source = value as Partial<TranslationResponse['source']>;
      return Number.isInteger(source.revision) && typeof source.fingerprint === 'string' && typeof source.title === 'string'
        && (typeof source.description === 'string' || source.description === null) && typeof source.content === 'string'
        && stringMap(source.image_alts) && Array.isArray(source.tags) && source.tags.every((tag) => typeof tag === 'string')
        && (typeof source.alphabet_key === 'string' || source.alphabet_key === null);
    }
    function validResponse(value: unknown): value is TranslationResponse {
      if (!value || typeof value !== 'object') return false;
      const data = value as Partial<TranslationResponse>;
      return data.ok === true && typeof data.content_id === 'string' && CONTENT_ID_RE.test(data.content_id) && validLocale(data.locale ?? null)
        && validSource(data.source) && !!data.translation_state && typeof data.translation_state === 'object'
        && validPublication(data.translation_state.publication_state) && validSync(data.translation_state.draft_synchronization) && validSync(data.translation_state.published_synchronization)
        && typeof data.slug_locked === 'boolean' && (typeof data.alphabet_suggestion === 'string' || data.alphabet_suggestion === null)
        && (typeof data.locale_blob_sha === 'string' || data.locale_blob_sha === null) && (data.locale_document === null || (
          typeof data.locale_document === 'object' && !Array.isArray(data.locale_document)
          && (data.locale_document.draft === null || validPayload(data.locale_document.draft))
          && (data.locale_document.published === null || validPayload(data.locale_document.published, true))
        ));
    }
    function configureLocaleLinks(id: string, active: Locale) {
      document.querySelectorAll<HTMLAnchorElement>('[data-locale-link]').forEach((link) => {
        const next = link.dataset.localeLink as Locale;
        link.href = `/admin/translations/edit/?${new URLSearchParams({ content_id: id, locale: next })}`;
