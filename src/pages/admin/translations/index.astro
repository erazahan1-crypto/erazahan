---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { scanContentStore } from '../../../lib/content-source/multilingual-store.mjs';
import { projectTranslationDashboard } from '../../../lib/content-source/translation-dashboard.mjs';

const rows = projectTranslationDashboard(scanContentStore('src/data/content/dreams'));
const dashboardData = JSON.stringify(rows).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026');
---

<AdminLayout title="Переводы — Админка">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm font-medium text-violet-300">RU / EN локализация</p>
      <h1 class="mt-1 font-display text-3xl font-bold text-white">Переводы</h1>
      <p class="mt-2 text-sm text-slate-400"><span data-total></span> логических записей. Страница только показывает состояние и ссылки.</p>
    </div>
  </div>

  <section data-summary class="mt-6 grid gap-3 sm:grid-cols-2" aria-label="Сводка переводов"></section>

  <section class="mt-6 grid gap-3 rounded-2xl border border-white/10 bg-white/[0.035] p-4 lg:grid-cols-[minmax(0,1fr)_10rem_14rem_12rem]" aria-label="Поиск, фильтрация и сортировка">
    <label class="block"><span class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400">Поиск</span><input data-search type="search" autocomplete="off" placeholder="HY, RU, EN, slug или content ID" class="min-h-11 w-full rounded-xl border border-white/10 bg-night-950 px-3 text-white outline-none placeholder:text-slate-500 focus:border-violet-400" /></label>
    <label class="block"><span class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400">Язык</span><select data-locale class="min-h-11 w-full rounded-xl border border-white/10 bg-night-950 px-3 text-white"><option value="all">Все</option><option value="ru">RU</option><option value="en">EN</option></select></label>
    <label class="block"><span class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400">Состояние</span><select data-state class="min-h-11 w-full rounded-xl border border-white/10 bg-night-950 px-3 text-white"><option value="all">Все состояния</option><option value="NOT_CREATED">Не создан</option><option value="DRAFT">Черновик</option><option value="PUBLISHED">Опубликован</option><option value="PUBLISHED_WITH_DRAFT">Опубликован + черновик</option><option value="OUTDATED">Устарел</option></select></label>
    <label class="block"><span class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400">Сортировка</span><select data-sort class="min-h-11 w-full rounded-xl border border-white/10 bg-night-950 px-3 text-white"><option value="source">Исходный порядок HY</option><option value="title">Заголовок HY</option><option value="status">Статус перевода</option></select></label>
  </section>

  <section class="mt-4 overflow-hidden rounded-2xl border border-white/10 bg-white/[0.035]" aria-label="Список переводов">
    <div class="hidden grid-cols-[minmax(0,2fr)_minmax(13rem,1fr)_minmax(13rem,1fr)] gap-4 border-b border-white/10 bg-white/5 px-5 py-3 text-xs font-semibold uppercase tracking-wide text-slate-400 lg:grid"><span>HY источник</span><span>RU</span><span>EN</span></div>
    <div data-list class="divide-y divide-white/10"></div>
    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-white/10 px-4 py-3"><p data-count class="text-sm text-slate-400"></p><div class="flex gap-2"><button data-prev type="button" class="min-h-11 rounded-xl border border-white/10 px-4 text-sm font-semibold text-slate-200 disabled:cursor-not-allowed disabled:opacity-40">Назад</button><button data-next type="button" class="min-h-11 rounded-xl border border-white/10 px-4 text-sm font-semibold text-slate-200 disabled:cursor-not-allowed disabled:opacity-40">Далее</button></div></div>
  </section>

  <script define:vars={{ dashboardData }}>
    import { translationDashboardSearchText } from '../../../lib/content-source/translation-dashboard.mjs';
    type PublicationState = 'NOT_CREATED' | 'DRAFT' | 'PUBLISHED' | 'PUBLISHED_WITH_DRAFT';
    type LocaleRow = { publication_state: PublicationState; outdated: boolean; draft: { title: string; slug: string } | null; published: { title: string; slug: string; path: string } | null };
    type DashboardRow = { content_id: string; hy: { title: string; slug: string }; ru: LocaleRow; en: LocaleRow };
    const rows = JSON.parse(dashboardData) as DashboardRow[];
    const PAGE_SIZE = 50;
    const search = document.querySelector<HTMLInputElement>('[data-search]')!;
    const localeFilter = document.querySelector<HTMLSelectElement>('[data-locale]')!;
    const stateFilter = document.querySelector<HTMLSelectElement>('[data-state]')!;
    const sort = document.querySelector<HTMLSelectElement>('[data-sort]')!;
    const list = document.querySelector<HTMLElement>('[data-list]')!;
    const summary = document.querySelector<HTMLElement>('[data-summary]')!;
    const count = document.querySelector<HTMLElement>('[data-count]')!;
    const prev = document.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = document.querySelector<HTMLButtonElement>('[data-next]')!;
    let page = 0;
    const collator = new Intl.Collator('hy-AM', { sensitivity: 'base', numeric: true });
    const stateLabel: Record<PublicationState, string> = { NOT_CREATED: 'Не создан', DRAFT: 'Черновик', PUBLISHED: 'Опубликован', PUBLISHED_WITH_DRAFT: 'Опубликован + черновик' };

    function searchable(row: DashboardRow) { return translationDashboardSearchText(row); }
    function matchesState(locale: LocaleRow) { return stateFilter.value === 'OUTDATED' ? locale.outdated : stateFilter.value === 'all' || locale.publication_state === stateFilter.value; }
    function filteredRows() {
      const query = search.value.trim().toLocaleLowerCase(); const locales = localeFilter.value === 'all' ? ['ru', 'en'] as const : [localeFilter.value as 'ru' | 'en'];
      let result = rows.filter((row) => (!query || searchable(row).includes(query)) && locales.some((locale) => matchesState(row[locale])));
      if (sort.value === 'title') result = [...result].sort((a, b) => collator.compare(a.hy.title, b.hy.title));
      if (sort.value === 'status') result = [...result].sort((a, b) => statusRank(a) - statusRank(b) || collator.compare(a.hy.title, b.hy.title));
      return result;
    }
    function statusRank(row: DashboardRow) { return Math.min(...(['ru', 'en'] as const).map((locale) => row[locale].outdated ? -1 : ['NOT_CREATED', 'DRAFT', 'PUBLISHED', 'PUBLISHED_WITH_DRAFT'].indexOf(row[locale].publication_state))); }
    function editorUrl(contentId: string, locale: 'ru' | 'en') { return `/admin/translations/edit/?${new URLSearchParams({ content_id: contentId, locale })}`; }
    function appendButton(parent: HTMLElement, text: string, href: string, primary = false) { const link = document.createElement('a'); link.href = href; link.className = `inline-flex min-h-9 items-center rounded-lg px-3 text-xs font-semibold ${primary ? 'bg-violet-600 text-white hover:bg-violet-500' : 'border border-white/10 text-slate-200 hover:bg-white/5'}`; link.textContent = text; parent.append(link); }
    function renderLocale(row: DashboardRow, locale: 'ru' | 'en') {
      const data = row[locale]; const section = document.createElement('section'); section.className = 'min-w-0';
      const heading = document.createElement('p'); heading.className = 'text-xs font-semibold uppercase tracking-wide text-slate-400'; heading.textContent = locale;
      const state = document.createElement('p'); state.className = 'mt-1 text-sm font-semibold text-white'; state.textContent = stateLabel[data.publication_state];
      section.append(heading, state);
      if (data.outdated) { const freshness = document.createElement('span'); freshness.className = 'mt-1 inline-flex rounded-md border border-amber-400/30 bg-amber-500/10 px-2 py-0.5 text-xs font-semibold text-amber-200'; freshness.textContent = 'Устарел'; section.append(freshness); }
      const detail = data.draft ?? data.published;
      if (detail) { const label = document.createElement('p'); label.className = 'mt-2 break-words text-xs text-slate-400'; label.textContent = `${detail.title} · ${detail.slug}`; section.append(label); }
      const actions = document.createElement('div'); actions.className = 'mt-3 flex flex-wrap gap-2';
      appendButton(actions, data.publication_state === 'NOT_CREATED' ? 'Создать перевод' : 'Редактировать', editorUrl(row.content_id, locale), true);
      if (data.published) { appendButton(actions, 'Открыть', data.published.path); const open = actions.lastElementChild as HTMLAnchorElement; open.target = '_blank'; open.rel = 'noopener'; }
      section.append(actions); return section;
    }
    function renderRow(row: DashboardRow) { const article = document.createElement('article'); article.className = 'grid gap-5 px-4 py-5 lg:grid-cols-[minmax(0,2fr)_minmax(13rem,1fr)_minmax(13rem,1fr)] lg:gap-4 lg:px-5'; const hy = document.createElement('section'); const title = document.createElement('strong'); title.className = 'block break-words text-sm text-white'; title.textContent = row.hy.title; const slug = document.createElement('p'); slug.className = 'mt-1 break-all font-mono text-xs text-slate-400'; slug.textContent = `/${row.hy.slug}/`; const id = document.createElement('code'); id.className = 'mt-2 block break-all text-xs text-slate-500'; id.textContent = row.content_id; hy.append(title, slug, id); article.append(hy, renderLocale(row, 'ru'), renderLocale(row, 'en')); return article; }
    function render() { const result = filteredRows(); const pages = Math.max(1, Math.ceil(result.length / PAGE_SIZE)); page = Math.min(page, pages - 1); const visible = result.slice(page * PAGE_SIZE, (page + 1) * PAGE_SIZE); list.replaceChildren(...visible.map(renderRow)); count.textContent = result.length ? `${page * PAGE_SIZE + 1}–${Math.min((page + 1) * PAGE_SIZE, result.length)} из ${result.length.toLocaleString('ru-RU')}` : 'Ничего не найдено'; prev.disabled = page === 0; next.disabled = page >= pages - 1; }
    function renderSummary() { const card = (locale: 'ru' | 'en') => { const values = rows.map((row) => row[locale]); const counts = { published: values.filter((value) => value.published).length, drafts: values.filter((value) => value.draft).length, notCreated: values.filter((value) => value.publication_state === 'NOT_CREATED').length, outdated: values.filter((value) => value.outdated).length }; const section = document.createElement('section'); section.className = 'rounded-2xl border border-white/10 bg-white/[0.035] p-4'; const heading = document.createElement('h2'); heading.className = 'font-display text-xl font-bold text-white'; heading.textContent = locale.toUpperCase(); const body = document.createElement('p'); body.className = 'mt-2 text-sm text-slate-300'; body.textContent = `Опубликовано: ${counts.published} · Черновики: ${counts.drafts} · Не создано: ${counts.notCreated} · Устарело: ${counts.outdated}`; section.append(heading, body); return section; }; summary.append(card('ru'), card('en')); document.querySelector<HTMLElement>('[data-total]')!.textContent = rows.length.toLocaleString('ru-RU'); }
    let searchTimer = 0;
    search.addEventListener('input', () => { clearTimeout(searchTimer); searchTimer = window.setTimeout(() => { page = 0; render(); }, 120); });
    for (const control of [localeFilter, stateFilter, sort]) control.addEventListener('change', () => { page = 0; render(); });
    prev.addEventListener('click', () => { page -= 1; render(); }); next.addEventListener('click', () => { page += 1; render(); });
    renderSummary(); render();
  </script>
</AdminLayout>
