---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Չգտնված երազներ — ուղարկեք ձեր երազը"
  description="Չգտա՞ք ձեր երազի մեկնաբանությունը։ Ուղարկեք երազի նկարագրությունը, և պատասխանը կհրապարակվի ավելի ուշ։ Ձեր էլփոստի հասցեն չի հրապարակվի։"
>
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="starfield absolute inset-0 opacity-40"></div>
      <div class="absolute left-1/2 top-0 h-64 w-[32rem] -translate-x-1/2 rounded-full bg-violet-600/15 blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-3xl px-4 pb-5 pt-8 text-center sm:px-6 sm:pb-7 sm:pt-11">
      <span class="inline-flex size-10 items-center justify-center rounded-xl border border-violet-300/20 bg-violet-500/15 text-xl" aria-hidden="true">☾</span>
      <h1 class="mt-3 font-display text-3xl font-bold leading-tight text-white sm:text-4xl">Չգտնված երազներ</h1>
      <p class="mx-auto mt-3 max-w-2xl text-base leading-7 text-slate-300">
        Եթե կայքում չգտաք ձեր երազի մեկնաբանությունը, նկարագրեք այն այստեղ։ Պատասխանը չի հայտնվում անմիջապես․ կայքի խմբագիրը կդիտարկի այն և կհրապարակի ավելի ուշ։ Էլփոստով ծանուցումը կգործի ապագայում, իսկ ձեր հասցեն երբեք չի հրապարակվի։
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-3 pb-8 sm:px-6 sm:pb-11">
    <div class="rounded-2xl border border-white/10 bg-white/[0.055] p-4 shadow-xl shadow-violet-950/15 sm:p-7">
      <div class="flex items-start gap-3">
        <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-violet-500 to-indigo-700 text-lg" aria-hidden="true">✦</span>
        <div>
          <h2 class="font-display text-xl font-bold leading-tight text-white sm:text-2xl">Ուղարկեք ձեր երազը</h2>
          <p class="mt-1 text-sm leading-6 text-slate-300">Նկարագրեք հիշվող մանրամասները, մարդկանց, վայրերը և ձեր զգացողությունները։</p>
        </div>
      </div>

      <form class="mt-6 space-y-4" data-dream-form novalidate>
        <div>
          <div class="flex items-center justify-between gap-3">
            <label class="block text-sm font-semibold text-slate-100" for="dream-name">Անուն կամ կեղծանուն</label>
            <span class="text-xs text-slate-400">Պարտադիր չէ</span>
          </div>
          <input
            id="dream-name"
            name="name"
            type="text"
            autocomplete="name"
            maxlength="80"
            placeholder="Ինչպե՞ս դիմենք ձեզ"
            class="mt-1.5 min-h-13 w-full rounded-xl border border-white/10 bg-night-950/60 px-4 py-3 text-base text-white placeholder:text-slate-500 outline-none transition focus:border-violet-400/70 focus:ring-2 focus:ring-violet-500/25"
          />
          <p class="mt-1.5 hidden text-sm text-rose-300" data-error-for="name"></p>
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-100" for="dream-email">Էլփոստի հասցե</label>
          <input
            id="dream-email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            required
            maxlength="254"
            placeholder="Ձեր էլ. փոստը"
            aria-describedby="email-note email-error"
            class="mt-1.5 min-h-13 w-full rounded-xl border border-white/10 bg-night-950/60 px-4 py-3 text-base text-white placeholder:text-slate-500 outline-none transition focus:border-violet-400/70 focus:ring-2 focus:ring-violet-500/25"
          />
          <p id="email-note" class="mt-2 flex gap-2 text-sm leading-5 text-slate-400">
            <span aria-hidden="true">🔒</span>
            <span>Ձեր էլփոստի հասցեն չի հրապարակվի և կօգտագործվի միայն պատասխանի մասին ծանուցելու համար։</span>
          </p>
          <p id="email-error" class="mt-1.5 hidden text-sm text-rose-300" data-error-for="email"></p>
        </div>

        <div>
          <div class="flex items-center justify-between gap-3">
            <label class="block text-sm font-semibold text-slate-100" for="dream-text">Երազի նկարագրությունը</label>
            <span class="shrink-0 text-xs tabular-nums text-slate-400"><span data-dream-count>0</span>/5000</span>
          </div>
          <textarea
            id="dream-text"
            name="dream_text"
            rows="8"
            required
            minlength="20"
            maxlength="5000"
            placeholder="Նկարագրեք ձեր երազը հնարավորինս մանրամասն..."
            aria-describedby="dream-error"
            class="mt-1.5 min-h-40 w-full resize-y rounded-xl border border-white/10 bg-night-950/60 px-4 py-3 text-base leading-7 text-white placeholder:text-slate-500 outline-none transition focus:border-violet-400/70 focus:ring-2 focus:ring-violet-500/25"
          ></textarea>
          <p id="dream-error" class="mt-1.5 hidden text-sm text-rose-300" data-error-for="dream_text"></p>
        </div>

        <div class="absolute -left-[10000px] top-auto size-px overflow-hidden" aria-hidden="true">
          <label for="dream-website">Կայք</label>
          <input id="dream-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <button
          type="submit"
          class="inline-flex min-h-13 w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-violet-500 to-indigo-600 px-6 py-3 text-base font-semibold text-white shadow-lg shadow-violet-950/40 transition hover:from-violet-400 hover:to-indigo-500 focus:outline-none focus:ring-2 focus:ring-violet-300 focus:ring-offset-2 focus:ring-offset-night-950 disabled:cursor-wait disabled:opacity-60"
        >
          <span data-submit-label>Ուղարկել երազը</span>
          <span aria-hidden="true">→</span>
        </button>

        <div class="hidden rounded-xl border px-4 py-3 text-base leading-6" role="status" aria-live="polite" data-form-status></div>
      </form>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-10 sm:px-6 sm:pb-14" aria-labelledby="how-it-works">
    <div class="rounded-2xl border border-white/8 bg-night-900/50 p-4 sm:p-6">
      <h2 id="how-it-works" class="font-display text-xl font-bold text-white sm:text-2xl">Ինչպե՞ս է սա աշխատում</h2>
      <ol class="mt-4 grid gap-3 sm:grid-cols-3 sm:gap-4">
        <li class="flex items-center gap-3 sm:items-start">
          <span class="grid size-9 shrink-0 place-items-center rounded-full bg-violet-500/20 font-semibold text-violet-200">1</span>
          <p class="text-sm leading-6 text-slate-300">Դուք ուղարկում եք ձեր երազի նկարագրությունը։</p>
        </li>
        <li class="flex items-center gap-3 sm:items-start">
          <span class="grid size-9 shrink-0 place-items-center rounded-full bg-violet-500/20 font-semibold text-violet-200">2</span>
          <p class="text-sm leading-6 text-slate-300">Կայքի խմբագիրը կարդում և պատրաստում է պատասխանը։</p>
        </li>
        <li class="flex items-center gap-3 sm:items-start">
          <span class="grid size-9 shrink-0 place-items-center rounded-full bg-violet-500/20 font-semibold text-violet-200">3</span>
          <p class="text-sm leading-6 text-slate-300">Պատասխանը հրապարակվում է ավելի ուշ, և դուք ծանուցում եք ստանում։</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="border-t border-white/5 bg-night-900/25">
    <div class="mx-auto max-w-5xl px-3 py-10 sm:px-6 sm:py-14">
      <div class="max-w-2xl">
        <h2 class="mt-1.5 font-display text-2xl font-bold leading-tight text-white sm:text-3xl">Վերջին երազներն ու պատասխանները</h2>
      </div>

      <p data-published-status class="mt-6 rounded-xl border border-white/10 bg-white/[0.055] px-4 py-4 text-sm leading-6 text-slate-300">
        Հրապարակված պատասխանները բեռնվում են…
      </p>
      <div data-published-list class="mt-6 grid gap-5 lg:grid-cols-2" aria-live="polite"></div>
    </div>
  </section>

  <style is:global>
    @media (max-width: 639px) {
      [aria-label="Արագ գործիքներ"] > button,
      [aria-label="Արագ գործիքներ"] > a {
        opacity: 0.64;
        border-color: rgba(255, 255, 255, 0.24);
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(8px);
        transition-property: opacity, transform, color, background-color, border-color;
        transition-duration: 180ms;
        transition-timing-function: ease;
      }

      [aria-label="Արագ գործիքներ"] > button:hover,
      [aria-label="Արագ գործիքներ"] > button:focus-visible,
      [aria-label="Արագ գործիքներ"] > button:active,
      [aria-label="Արագ գործիքներ"] > a:hover,
      [aria-label="Արագ գործիքներ"] > a:focus-visible,
      [aria-label="Արագ գործիքներ"] > a:active {
        opacity: 1;
      }
    }
  </style>

  <script>
    interface PublishedDream {
      id: string;
      name: string | null;
      dream_text: string;
      answer_text: string;
      created_at: string;
      answered_at: string | null;
      updated_at: string;
      status: string;
    }

    interface PublishedDreamsResponse {
      ok: boolean;
      dreams?: PublishedDream[];
      error?: string;
    }

    const form = document.querySelector<HTMLFormElement>('[data-dream-form]');
    const dream = form?.querySelector<HTMLTextAreaElement>('[name="dream_text"]');
    const count = form?.querySelector<HTMLElement>('[data-dream-count]');
    const status = form?.querySelector<HTMLElement>('[data-form-status]');
    const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    const submitLabel = form?.querySelector<HTMLElement>('[data-submit-label]');

    const setCount = () => {
      if (dream && count) count.textContent = String(dream.value.length);
    };

    const showFieldError = (name: string, message = '') => {
      const element = form?.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      const field = form?.elements.namedItem(name);
      element?.classList.toggle('hidden', !message);
      if (element) element.textContent = message;
      if (field instanceof HTMLElement) field.setAttribute('aria-invalid', message ? 'true' : 'false');
    };

    const validate = () => {
      if (!form) return false;
      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const dreamText = String(data.get('dream_text') ?? '').trim();
      let valid = true;

      showFieldError('name', name.length > 80 ? 'Անունը չպետք է գերազանցի 80 նիշը։' : '');
      if (name.length > 80) valid = false;

      const emailField = form.elements.namedItem('email') as HTMLInputElement;
      const emailError = !email
        ? 'Նշեք ձեր էլփոստի հասցեն։'
        : email.length > 254 || !emailField.validity.valid
          ? 'Նշեք վավեր էլփոստի հասցե։'
          : '';
      showFieldError('email', emailError);
      if (emailError) valid = false;

      const dreamError = !dreamText
        ? 'Նկարագրեք ձեր երազը։'
        : dreamText.length < 20
          ? 'Երազի նկարագրությունը պետք է պարունակի առնվազն 20 նիշ։'
          : dreamText.length > 5000
            ? 'Երազի նկարագրությունը չպետք է գերազանցի 5000 նիշը։'
            : '';
      showFieldError('dream_text', dreamError);
      if (dreamError) valid = false;

      return valid;
    };

    dream?.addEventListener('input', setCount);
    setCount();

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      status?.classList.add('hidden');
      if (!validate() || !form || !button || !submitLabel) return;

      button.disabled = true;
      submitLabel.textContent = 'Ուղարկվում է…';
      try {
        const response = await fetch('/api/dreams', { method: 'POST', body: new FormData(form) });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.ok) throw new Error(result.error || 'Չհաջողվեց ուղարկել երազը։');

        form.reset();
        setCount();
        ['name', 'email', 'dream_text'].forEach((name) => showFieldError(name));
        if (status) {
          status.textContent = 'Շնորհակալություն։ Ձեր երազն ուղարկվել է և կդիտարկվի շուտով։';
          status.className = 'rounded-xl border border-emerald-400/30 bg-emerald-400/10 px-4 py-3 text-base leading-6 text-emerald-200';
        }
      } catch (error) {
        if (status) {
          status.textContent = error instanceof Error ? error.message : 'Չհաջողվեց ուղարկել երազը։ Խնդրում ենք փորձել ավելի ուշ։';
          status.className = 'rounded-xl border border-rose-400/30 bg-rose-400/10 px-4 py-3 text-base leading-6 text-rose-200';
        }
      } finally {
        button.disabled = false;
        submitLabel.textContent = 'Ուղարկել երազը';
      }
    });

    const publishedList = document.querySelector<HTMLElement>('[data-published-list]');
    const publishedStatus = document.querySelector<HTMLElement>('[data-published-status]');

    const appendInlineMarkdown = (parent: HTMLElement, value: string) => {
      const tokenPattern = /\*\*([^*\n]+)\*\*|\[([^\]\n]+)\]\((\/(?!\/)[^)\s\\]+)\)/g;
      let cursor = 0;

      for (const match of value.matchAll(tokenPattern)) {
        const index = match.index ?? 0;
        parent.append(document.createTextNode(value.slice(cursor, index)));

        if (match[1]) {
          const strong = document.createElement('strong');
          strong.textContent = match[1];
          parent.append(strong);
        } else if (match[2] && match[3]) {
          const link = document.createElement('a');
          link.href = match[3];
          link.textContent = match[2];
          link.className = 'font-semibold text-violet-200 underline decoration-violet-400 underline-offset-2 hover:text-white';
          parent.append(link);
        }

        cursor = index + match[0].length;
      }

      parent.append(document.createTextNode(value.slice(cursor)));
    };

    const renderMarkdown = (markdown: string): HTMLElement => {
      const wrapper = document.createElement('div');
      wrapper.className = 'mt-2 space-y-3 text-base leading-7 text-slate-300';
      const lines = markdown.replace(/\r\n?/g, '\n').split('\n');
      let paragraphLines: string[] = [];
      let currentList: HTMLUListElement | HTMLOListElement | null = null;
      let currentListType = '';

      const flushParagraph = () => {
        if (paragraphLines.length === 0) return;
        const paragraph = document.createElement('p');
        appendInlineMarkdown(paragraph, paragraphLines.join(' '));
        wrapper.append(paragraph);
        paragraphLines = [];
      };

      for (const line of lines) {
        if (!line.trim()) {
          flushParagraph();
          currentList = null;
          currentListType = '';
          continue;
        }

        const unorderedItem = line.match(/^\s*[-*]\s+(.+)$/);
        const orderedItem = line.match(/^\s*\d+[.)]\s+(.+)$/);
        const listItem = unorderedItem?.[1] ?? orderedItem?.[1];
        const listType = unorderedItem ? 'ul' : orderedItem ? 'ol' : '';

        if (listItem && listType) {
          flushParagraph();
          if (!currentList || currentListType !== listType) {
            currentList = document.createElement(listType) as HTMLUListElement | HTMLOListElement;
            currentList.className = listType === 'ul' ? 'list-disc space-y-1 pl-5' : 'list-decimal space-y-1 pl-5';
            wrapper.append(currentList);
            currentListType = listType;
          }
          const item = document.createElement('li');
          appendInlineMarkdown(item, listItem);
          currentList.append(item);
          continue;
        }

        currentList = null;
        currentListType = '';
        paragraphLines.push(line.trim());
      }

      flushParagraph();
      return wrapper;
    };

    const formatPublishedDate = (dream: PublishedDream): string => {
      const value = dream.answered_at || dream.updated_at || dream.created_at;
      const date = new Date(value);
      return Number.isNaN(date.getTime())
        ? ''
        : date.toLocaleDateString('hy-AM', { year: 'numeric', month: 'long', day: 'numeric' });
    };

    const createReactionButton = (label: string): HTMLButtonElement => {
      const button = document.createElement('button');
      button.type = 'button';
      button.disabled = true;
      button.textContent = label;
      button.className = 'flex min-h-11 items-center justify-center rounded-xl border border-white/10 bg-white/5 px-3 text-sm text-slate-300 disabled:cursor-default disabled:opacity-75';
      return button;
    };

    const createPublishedCard = (dream: PublishedDream): HTMLElement => {
      const article = document.createElement('article');
      article.className = 'flex flex-col rounded-2xl border border-white/10 bg-white/[0.055] p-4 sm:p-6';

      const meta = document.createElement('div');
      meta.className = 'flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-slate-400';
      const answered = document.createElement('span');
      answered.className = 'inline-flex items-center gap-1.5 text-emerald-300';
      const dot = document.createElement('span');
      dot.className = 'size-1.5 rounded-full bg-current';
      dot.setAttribute('aria-hidden', 'true');
      answered.append(dot, document.createTextNode('Պատասխանված է'));
      meta.append(answered);

      const formattedDate = formatPublishedDate(dream);
      if (formattedDate) {
        const separator = document.createElement('span');
        separator.textContent = '·';
        separator.setAttribute('aria-hidden', 'true');
        const time = document.createElement('time');
        time.dateTime = dream.answered_at || dream.updated_at || dream.created_at;
        time.textContent = formattedDate;
        meta.append(separator, time);
      }

      const title = document.createElement('h3');
      title.className = 'mt-3 font-display text-xl font-bold leading-snug text-white sm:text-2xl';
      title.textContent = 'Օգտատիրոջ երազը';

      const author = document.createElement('p');
      author.className = 'mt-1 text-sm font-medium text-violet-200';
      author.textContent = `Պատմել է՝ ${dream.name?.trim() || 'Անանուն'}`;

      const dreamText = document.createElement('p');
      dreamText.className = 'mt-4 whitespace-pre-line text-base leading-7 text-slate-200';
      dreamText.textContent = dream.dream_text;

      const answerBox = document.createElement('div');
      answerBox.className = 'mt-5 rounded-xl border border-violet-300/10 bg-violet-500/10 p-4';
      const answerLabel = document.createElement('p');
      answerLabel.className = 'text-sm font-semibold text-violet-200';
      answerLabel.textContent = 'Պատասխան';
      answerBox.append(answerLabel, renderMarkdown(dream.answer_text));

      const footer = document.createElement('div');
      footer.className = 'mt-auto pt-5';
      const reactions = document.createElement('div');
      reactions.className = 'grid grid-cols-2 gap-2 sm:grid-cols-3';
      reactions.setAttribute('aria-label', 'Արձագանքներ և մեկնաբանություններ');
      const useful = createReactionButton('👍 Օգտակար');
      const interesting = createReactionButton('❤️ Հետաքրքիր');
      const comments = createReactionButton('💬 Մեկնաբանություններ');
      comments.classList.add('col-span-2', 'sm:col-span-1');
      reactions.append(useful, interesting, comments);
      footer.append(reactions);

      article.append(meta, title, author, dreamText, answerBox, footer);
      return article;
    };

    const loadPublishedDreams = async () => {
      if (!publishedList || !publishedStatus) return;

      try {
        const response = await fetch('/api/published-dreams', {
          headers: { Accept: 'application/json' },
        });
        const result = (await response.json()) as PublishedDreamsResponse;

        if (!response.ok || !result.ok || !Array.isArray(result.dreams)) {
          throw new Error(result.error || 'Failed to load published dreams');
        }

        publishedList.replaceChildren(...result.dreams.map(createPublishedCard));
        if (result.dreams.length === 0) {
          publishedStatus.textContent = 'Հրապարակված պատասխաններ դեռ չկան։';
          publishedStatus.hidden = false;
        } else {
          publishedStatus.hidden = true;
        }
      } catch {
        publishedList.replaceChildren();
        publishedStatus.textContent = 'Չհաջողվեց բեռնել հրապարակված պատասխանները։ Խնդրում ենք փորձել մի փոքր ուշ։';
        publishedStatus.hidden = false;
      }
    };

    void loadPublishedDreams();
  </script>
</Layout>
