---
import Layout from '../../layouts/Layout.astro';
import { listLocalizedDreamRouteEntries } from '../../lib/content-source/localized-dream-routes.mjs';
import { loadLocalizedRenderContext } from '../../lib/content-source/localized-render-context.mjs';
import { buildPublishedSeoContext } from '../../lib/content-source/published-seo.mjs';
import { renderLocalizedContent } from '../../lib/localized-content-pipeline.mjs';
import LocalizedDreamBreadcrumb from '../../components/LocalizedDreamBreadcrumb.astro';

const localizedRenderContext = loadLocalizedRenderContext();

export function getStaticPaths() {
  const { repository } = loadLocalizedRenderContext();
  return listLocalizedDreamRouteEntries(repository, 'en').map((route) => ({
    params: { slug: route.slug },
    props: { entry: route.entry, seo: buildPublishedSeoContext(repository, route.entry.content_id, 'en') },
  }));
}

const { entry, seo } = Astro.props;
const renderedContent = renderLocalizedContent({ content: entry.published.content, imageAlts: entry.published.image_alts, locale: 'en', currentContentId: entry.content_id, ...localizedRenderContext });
---

<Layout title={entry.published.title} description={entry.published.description || undefined} type="article" locale={seo.locale} alternates={seo.alternates}>
  <article class="post-article reveal mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <LocalizedDreamBreadcrumb locale="en" entry={entry} />
    <h1 class="font-display text-3xl font-bold leading-tight text-white sm:text-4xl">{entry.published.title}</h1>
    <div class="dream-content mt-6" set:html={renderedContent} />
  </article>
</Layout>
