---
import Layout from '../../layouts/Layout.astro';
import { loadLocalizedDreamRouteEntries } from '../../lib/content-source/localized-dream-routes.mjs';
import { renderPostContent } from '../../lib/render-post-content';

export function getStaticPaths() {
  return loadLocalizedDreamRouteEntries('en').map((route) => ({
    params: { slug: route.slug },
    props: { entry: route.entry },
  }));
}

const { entry } = Astro.props;
const renderedContent = renderPostContent(entry.published.content);
---

<Layout title={entry.published.title} description={entry.published.description || undefined} type="article">
  <article class="post-article reveal mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <h1 class="font-display text-3xl font-bold leading-tight text-white sm:text-4xl">{entry.published.title}</h1>
    <div class="dream-content mt-6" set:html={renderedContent} />
  </article>
</Layout>
