---
import Layout from '../layouts/Layout.astro';
import { posts, menu, ALPHABET, normLetter, letterPathByLetter, stripHtml, postCover } from '../lib/site';

const dreamPosts = posts.filter((p) => p.letter);

// Снаг с обложками ставим первыми, внутри сортируем по числу комментариев
const coverSet = new Set(dreamPosts.filter((p) => postCover(p)).map((p) => p.slug));
const popular = [...dreamPosts]
  .sort((a, b) => {
    const aCover = coverSet.has(a.slug) ? 1 : 0;
    const bCover = coverSet.has(b.slug) ? 1 : 0;
    if (aCover !== bCover) return bCover - aCover;
    return b.comments.length - a.comments.length;
  })
  .slice(0, 6);

const sections = menu.filter((m) => m.parent === '0' && m.href);

const emojiByLabel: Record<string, string> = {
  'Երազահան': '🌙',
  'Բաղտագուշակություն': '🔮',
  'Անվան Նշանակությունը': '📖',
  'Կարևոր Տարեթվեր': '📅',
  'Գանգաբանություն': '🧠',
  'Աստղագուշակ': '⭐',
  'Թվագիտություն': '🔢',
  'Չգնտված Երազներ': '💭',
  'Մեր Մասին': '👥',
};

const usefulPages = [
  { href: '/karevor-taretver/', label: 'Որքանով է նպասաոր Ձեր Ծննդյան Տարեթիվը', emoji: '📅' },
  { href: '/eraznei-bacatrutyan-lav-orer/', label: 'Երազների բացատրության լավ օրեր', emoji: '✅' },
  { href: '/eraznei-bacatrutyan-hamar-vat-orer/', label: 'Երազների բացատրության գեշ օրեր', emoji: '⚠️' },
];

const excerpt = (html: string, len = 160) => {
  const t = stripHtml(html);
  return t.length > len ? t.slice(0, len) + '…' : t;
};
---

<Layout>
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="starfield absolute inset-0 opacity-70 animate-twinkle"></div>
      <div class="starfield-2 absolute inset-0 animate-twinkle-alt"></div>
      <div
        class="animate-blob absolute -top-24 left-1/2 h-96 w-[42rem] -translate-x-1/2 rounded-full bg-violet-600/20 blur-3xl"
      ></div>
      <div class="animate-blob-slow absolute -left-32 top-1/3 h-72 w-72 rounded-full bg-indigo-600/20 blur-3xl"></div>
      <div class="animate-blob absolute -right-32 top-1/3 h-72 w-72 rounded-full bg-fuchsia-600/15 blur-3xl" style="animation-delay:-7s"></div>
    </div>

    <div class="relative mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 sm:py-24">
      <h1
        class="font-display text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl md:text-6xl"
      >
        <span class="shimmer-text">Երազահան</span>
      </h1>

      <span
        class="mt-5 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-sm text-slate-300"
      >
        🌙 Ավելի քան 4000 երազների մեկնաբանություն
      </span>

      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-slate-400 sm:text-lg">
        Իմացեք, թե ինչ է նշանակում ձեր երազը: Փնտրեք բառը և ստացեք ճշգրիտ ու մանրամասն մեկնաբանություն:
      </p>

      <form action="/search" method="get" role="search" class="mx-auto mt-9 max-w-2xl">
        <div
          class="flex items-center gap-2 rounded-2xl border border-white/10 bg-white/5 p-2 backdrop-blur transition focus-within:border-violet-400/60 focus-within:ring-2 focus-within:ring-violet-500/30"
        >
          <svg
            class="ml-2 size-5 shrink-0 text-slate-400"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M21 21l-4.35-4.35"></path>
          </svg>
          <input
            type="search"
            name="q"
            placeholder="Օրինակ՝ օձ, ջուր, թռիչք…"
            autocomplete="off"
            class="w-full bg-transparent px-2 py-2.5 text-white placeholder:text-slate-400 outline-none"
          />
          <button
            type="submit"
            class="shrink-0 rounded-xl bg-gradient-to-r from-violet-500 to-indigo-600 px-5 py-2.5 font-semibold text-white shadow-lg shadow-violet-900/40 transition hover:from-violet-400 hover:to-indigo-500 active:scale-95"
          >
            Փնտրել
          </button>
        </div>
      </form>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="#bajinner"
          class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-violet-500 to-indigo-600 px-6 py-3 font-semibold text-white shadow-lg shadow-violet-900/40 transition hover:from-violet-400 hover:to-indigo-500 active:scale-95"
        >
          Դիտել բաժինները
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path></svg>
        </a>
        <a
          href="/erazahan-online/"
          class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-6 py-3 font-semibold text-slate-200 transition hover:border-violet-400/60 hover:bg-white/10"
        >
          Այբբենական ցանկ
        </a>
      </div>
    </div>
  </section>

  <section class="reveal mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <h2 class="text-center font-display text-3xl font-bold text-white sm:text-4xl">
      Մեկնաբանություն ըստ այբուբենի
    </h2>
    <div class="mt-8 flex flex-wrap justify-center gap-2.5">
      {ALPHABET.map((letter) => {
        const path = letterPathByLetter.get(normLetter(letter));
        const cls =
          'grid size-10 place-items-center rounded-xl border border-white/10 bg-white/5 font-semibold text-slate-200 transition hover:scale-105 hover:border-violet-400/60 hover:bg-violet-500/20 hover:text-white sm:size-11';
        return path ? (
          <a href={`/${path}/`} class={cls}>
            {letter}
          </a>
        ) : (
          <span class="grid size-10 cursor-default place-items-center rounded-xl border border-white/5 bg-white/5 font-semibold text-slate-600 sm:size-11">
            {letter}
          </span>
        );
      })}
    </div>
  </section>

  <section id="bajinner" class="mx-auto max-w-6xl scroll-mt-24 px-4 pb-16 sm:px-6">
    <h2 class="reveal text-center font-display text-3xl font-bold text-white sm:text-4xl">Բաժիններ</h2>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {sections.map((s, i) => (
        <a
          href={s.href}
          style={`--reveal-delay: ${i * 70}ms`}
          class="reveal card-shine group rounded-2xl border border-white/10 bg-white/5 p-5 text-center transition hover:-translate-y-0.5 hover:border-violet-400/40 hover:bg-white/10"
        >
          <span class="text-3xl" aria-hidden="true">
            {emojiByLabel[s.label] || '🌙'}
          </span>
          <div class="mt-3 font-semibold text-white group-hover:text-violet-200">{s.label}</div>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <h2 class="reveal text-center font-display text-3xl font-bold text-white sm:text-4xl">Օգտակար էջեր</h2>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {usefulPages.map((p, i) => (
        <a
          href={p.href}
          style={`--reveal-delay: ${i * 70}ms`}
          class="reveal card-shine group rounded-2xl border border-white/10 bg-white/5 p-5 text-center transition hover:-translate-y-0.5 hover:border-violet-400/40 hover:bg-white/10"
        >
          <span class="text-3xl" aria-hidden="true">{p.emoji}</span>
          <div class="mt-3 font-semibold text-white group-hover:text-violet-200">{p.label}</div>
        </a>
      ))}
    </div>
  </section>

  <div data-featured-dreams-mount></div>

  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <h2 class="reveal text-center font-display text-3xl font-bold text-white sm:text-4xl">
      Հանրաճանաչ մեկնաբանություններ
    </h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {popular.map((p, i) => {
        const cover = postCover(p);
        return (
        <a
          href={`/${p.slug}/`}
          style={`--reveal-delay: ${i * 70}ms`}
          class="reveal card-shine group relative flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-white/5 p-6 transition hover:-translate-y-1 hover:border-violet-400/40 hover:bg-white/10 hover:shadow-xl hover:shadow-violet-900/30"
        >
          {cover ? (
            <div class="-mx-6 -mt-6 mb-4 h-40 overflow-hidden">
              <img src={cover} alt={p.title} class="h-full w-full object-cover" loading="lazy" />
            </div>
          ) : null}
          <div class="flex items-center gap-2">
            <span class="grid size-10 place-items-center rounded-xl bg-gradient-to-br from-violet-500/30 to-indigo-600/30 font-display text-lg font-bold text-white">
              {p.letter}
            </span>
            {p.comments.length > 0 ? (
              <span class="rounded-full border border-white/10 bg-white/10 px-3 py-1 text-xs font-medium text-slate-300">
                💬 {p.comments.length}
              </span>
            ) : null}
          </div>
          <h3 class="mt-4 font-display text-lg font-semibold leading-snug text-white transition group-hover:text-violet-200">
            {p.title}
          </h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-400">{excerpt(p.content)}</p>
          <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-violet-300 transition group-hover:text-white">
            Կարդալ մեկնաբանությունը
            <svg
              class="size-4 transition-transform group-hover:translate-x-1"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14"></path>
              <path d="M13 6l6 6-6 6"></path>
            </svg>
          </span>
        </a>
        );
      })}
    </div>
  </section>

  <script>
    interface FeaturedDreamCard {
      title: string;
      excerpt: string;
      url: string;
    }

    interface FeaturedDreamsResponse {
      ok: boolean;
      dreams?: FeaturedDreamCard[];
    }

    const mount = document.querySelector<HTMLElement>('[data-featured-dreams-mount]');

    const createFeaturedCard = (dream: FeaturedDreamCard): HTMLAnchorElement => {
      const card = document.createElement('a');
      card.href = dream.url;
      card.className = 'card-shine group flex min-w-0 flex-col rounded-2xl border border-white/10 bg-white/5 p-5 transition hover:-translate-y-0.5 hover:border-violet-400/40 hover:bg-white/10 sm:p-6';

      const title = document.createElement('h3');
      title.className = 'line-clamp-2 font-display text-lg font-semibold leading-snug text-white transition group-hover:text-[#D9BE82] [overflow-wrap:anywhere]';
      title.textContent = dream.title;

      const excerpt = document.createElement('p');
      excerpt.className = 'mt-2 line-clamp-3 flex-1 text-sm leading-relaxed text-slate-400 [overflow-wrap:anywhere]';
      excerpt.textContent = dream.excerpt;

      const action = document.createElement('span');
      action.className = 'mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-violet-300 transition group-hover:text-[#D9BE82]';
      action.textContent = 'Կարդալ մեկնաբանությունը →';

      card.append(title, excerpt, action);
      return card;
    };

    const renderFeaturedDreams = (dreams: FeaturedDreamCard[]) => {
      if (!mount || dreams.length === 0) return;

      const section = document.createElement('section');
      section.className = 'mx-auto max-w-6xl px-4 pb-16 sm:px-6';
      section.setAttribute('aria-labelledby', 'featured-dreams-heading');

      const heading = document.createElement('h2');
      heading.id = 'featured-dreams-heading';
      heading.className = 'text-center font-display text-3xl font-bold text-[#D2B57A] sm:text-4xl';
      heading.textContent = 'Վերջին մեկնաբանված երազները';

      const grid = document.createElement('div');
      grid.className = 'mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3';
      grid.append(...dreams.map(createFeaturedCard));
      section.append(heading, grid);
      mount.replaceChildren(section);
    };

    const loadFeaturedDreams = async () => {
      if (!mount) return;
      try {
        const response = await fetch('/api/published-dreams?featured=home', {
          headers: { Accept: 'application/json' },
        });
        const result = (await response.json()) as FeaturedDreamsResponse;
        if (!response.ok || !result.ok || !Array.isArray(result.dreams) || result.dreams.length === 0) return;
        renderFeaturedDreams(result.dreams.slice(0, 6));
      } catch {
        // The homepage remains unchanged when the optional runtime section is unavailable.
      }
    };

    void loadFeaturedDreams();
  </script>
</Layout>
