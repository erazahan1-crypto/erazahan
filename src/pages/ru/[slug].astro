---
import Layout from '../../layouts/Layout.astro';
import { CONTENT_STORE_ROOT, listLocalizedDreamRouteEntries } from '../../lib/content-source/localized-dream-routes.mjs';
import { scanContentStore } from '../../lib/content-source/multilingual-store.mjs';
import { buildPublishedSeoContext } from '../../lib/content-source/published-seo.mjs';
import { renderPostContent } from '../../lib/render-post-content';
import LocalizedDreamBreadcrumb from '../../components/LocalizedDreamBreadcrumb.astro';

export function getStaticPaths() {
  const repository = scanContentStore(CONTENT_STORE_ROOT);
  return listLocalizedDreamRouteEntries(repository, 'ru').map((route) => ({
    params: { slug: route.slug },
    props: { entry: route.entry, seo: buildPublishedSeoContext(repository, route.entry.content_id, 'ru') },
  }));
}

const { entry, seo } = Astro.props;
const renderedContent = renderPostContent(entry.published.content);
---

<Layout title={entry.published.title} description={entry.published.description || undefined} type="article" locale={seo.locale} alternates={seo.alternates}>
  <article class="post-article reveal mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <LocalizedDreamBreadcrumb locale="ru" entry={entry} />
    <h1 class="font-display text-3xl font-bold leading-tight text-white sm:text-4xl">{entry.published.title}</h1>
    <div class="dream-content mt-6" set:html={renderedContent} />
  </article>
</Layout>
