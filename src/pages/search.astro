---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Որոնում" description="Փնտրեք երազի մեկնաբանությունը">
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <h1 class="font-display text-3xl font-bold text-white">Որոնում</h1>

    <form class="mt-6" onsubmit="return false">
      <div class="flex items-center gap-2 rounded-2xl border border-white/10 bg-white/5 p-2 transition focus-within:border-violet-400/60 focus-within:ring-2 focus-within:ring-violet-500/30">
        <svg
          class="ml-2 size-5 shrink-0 text-slate-400"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M21 21l-4.35-4.35"></path>
        </svg>
        <input
          id="search-input"
          type="search"
          placeholder="Փնտրել երազ…"
          autocomplete="off"
          class="w-full bg-transparent px-2 py-2.5 text-white placeholder:text-slate-400 outline-none"
        />
      </div>
    </form>

    <div id="search-results" class="mt-6"></div>
  </div>
</Layout>

<script>
  import { prepareSearchIndex, rankPreparedSearch } from '../lib/public-search.mjs';

  type SearchIndexItem = {
    slug: string;
    title: string;
    text?: string;
    baseWord?: string;
    symbol?: string;
    keywords?: string[] | string;
    tags?: string[] | string;
  };

  const input = document.getElementById('search-input') as HTMLInputElement;
  const results = document.getElementById('search-results') as HTMLDivElement;
  const params = new URLSearchParams(window.location.search);
  const initialQ = params.get('q') || '';
  input.value = initialQ;

  let preparedIndex: ReturnType<typeof prepareSearchIndex> = [];

  function escapeHtml(s: string) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function run() {
    const term = input.value || '';
    if (!term.trim()) {
      results.innerHTML = '<p class="text-slate-400">Մուտքագրեք որոնման բառը:</p>';
      return;
    }
    const matches = rankPreparedSearch(term, preparedIndex, 60) as SearchIndexItem[];

    if (!matches.length) {
      results.innerHTML = '<p class="text-slate-400">Ոչինչ չի գտնվել:</p>';
      return;
    }

    results.innerHTML = matches
      .map(
        (item) => `
        <a href="/${item.slug}/" class="mb-3 block rounded-xl border border-white/10 bg-white/5 p-4 transition hover:border-violet-400/40 hover:bg-white/10">
          <div class="font-semibold text-white">${escapeHtml(item.title)}</div>
          ${item.text ? `<div class="mt-1 text-sm text-slate-400">${escapeHtml(item.text)}</div>` : ''}
        </a>
      `
      )
      .join('');
  }

  input.addEventListener('input', run);

  fetch('/search-index.json')
    .then((r) => r.json())
    .then((d) => {
      preparedIndex = prepareSearchIndex(d);
      if (initialQ) run();
    });
</script>
