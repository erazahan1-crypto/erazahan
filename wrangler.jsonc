{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "erazahan",
  "compatibility_date": "2026-09-06",
  "pages_build_output_dir": "./dist",
  "vars": {
    "ADMIN_GITHUB_REPO": "erazahan1-crypto/erazahan",
    "ADMIN_GITHUB_BRANCH": "main",
    "PUBLIC_ALLOW_INDEXING": "true"
  },
  "d1_databases": [
    {
      "binding": "DREAMS_DB",
      "database_name": "erazahan-dreams",
      "database_id": "1214b8ef-136b-40cd-8203-f6c426b0675a"
    }
  ],
  "r2_buckets": [
    {
      "binding": "POST_IMAGES",
      "bucket_name": "erazahan-images"
    }
  ],
  "env": {
    "production": {
      "vars": {
        "ADMIN_GITHUB_REPO": "erazahan1-crypto/erazahan",
        "ADMIN_GITHUB_BRANCH": "main",
        "PUBLIC_ALLOW_INDEXING": "true",
        "ERAZAHAN_HY_ADMIN_WRITE_MODE": "atomic",
        "ERAZAHAN_HY_ADMIN_ATOMIC_BRANCH": "main",
        "ERAZAHAN_HY_CONTENT_SOURCE": "new"
      },
      "d1_databases": [
        {
          "binding": "DREAMS_DB",
          "database_name": "erazahan-dreams",
          "database_id": "1214b8ef-136b-40cd-8203-f6c426b0675a"
        }
      ],
      "r2_buckets": [
        {
          "binding": "POST_IMAGES",
          "bucket_name": "erazahan-images"
        }
      ]
    },
    "preview": {
      "vars": {
        "ADMIN_GITHUB_REPO": "erazahan1-crypto/erazahan",
        "ADMIN_GITHUB_BRANCH": "locale-draft-drill-2026-09-16-b2",
        "ERAZAHAN_HY_CONTENT_SOURCE": "new",
        "PUBLIC_ALLOW_INDEXING": "false"
      },
      "d1_databases": [
        {
          "binding": "DREAMS_DB",
          "database_name": "erazahan-dreams",
          "database_id": "1214b8ef-136b-40cd-8203-f6c426b0675a"
        }
      ],
      "r2_buckets": [
        {
          "binding": "POST_IMAGES",
          "bucket_name": "erazahan-images"
        }
      ]
    }
  }
}
